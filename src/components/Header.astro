<style>
	@font-face {
		font-family: 'CreatypeStudio';
		src: url('/fonts/CreatypeStudio.woff2') format('woff2'),
		     url('/fonts/CreatypeStudio.woff') format('woff');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	header {
		margin: 0;
		padding: 1rem 2rem;
		background-color: #030a1c;
		background-image: 
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			radial-gradient(circle at 50% 30%, #102a5c 0%, #030a1c 80%);
		background-size: 80px 80px, 80px 80px, 100% 100%;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Logo & Title Layout */
	h2.site-logo {
		margin: 0;
		font-size: 1.1rem;
		background: transparent;
	}

	h2.site-logo a {
		display: flex;
		align-items: center;
		gap: 0.85rem; 
		color: #ffffff;
		text-decoration: none;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	/* Increased logo size */
	.logo-img {
		height: 52px; 
		width: auto;
		object-fit: contain;
		border-radius: 6px;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
	}

	.site-title {
		font-weight: 700;
		font-size: 1.2rem;
		line-height: 1.2;
		color: #ffffff;
	}

	.site-tagline {
		margin: 0;
		font-family: 'CreatypeStudio', cursive, sans-serif;
		font-size: 1.15rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.75);
		line-height: 1.2;
		margin-top: 0.1rem;
	}

	/* Internal Links Container */
	.internal-links {
		display: flex;
		gap: 2rem;
	}

	/* Navigation Link Typography & Colors */
	.internal-links :global(a) {
		padding: 0.5rem 0;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		font-size: 1.1rem;
		font-weight: 500;
		text-transform: capitalize;
		border-bottom: none;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: #ffffff;
		border-bottom: none;
	}

	/* Social Links */
	.social-links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.social-links a {
		color: rgba(255, 255, 255, 0.8);
		transition: color 0.2s ease;
	}

	.social-links a:hover {
		color: #ffffff;
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>