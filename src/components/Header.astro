---
const pathname = Astro.url.pathname;

const socialLinks = {
	youtube: "https://www.youtube.com/@Sceneandopinion",
	instagram: "https://www.instagram.com/sceneandopinion/",
	email: "mailto:sceneandopinion69@gmail.com",
};

const isHome = pathname === "/";
const isRead = pathname === "/blog" || pathname.startsWith("/blog/");
const isWatch = pathname === "/watch" || pathname.startsWith("/watch/");
---

<header class="site-header">
	<nav class="navbar">

		<!-- =========================================
		     LEFT — LOGO / BRAND
		========================================= -->

		<a
			href="/"
			class="brand"
			aria-label="Scene and Opinion Home"
		>
			<div class="logo-wrapper">
				<img
					src="/logo.png"
					alt="Scene and Opinion"
					class="logo"
					onerror="this.onerror=null; this.src='/logo.jpg';"
				/>
			</div>

			<div class="brand-text">
				<span class="brand-name">
					Scene &amp; Opinion
				</span>

				<span class="brand-tagline">
					Fresh reviews before the popcorn cools!
				</span>
			</div>
		</a>


		<!-- =========================================
		     CENTER — NAVIGATION
		========================================= -->

		<div class="nav-links">

			<a
				href="/"
				class:list={["nav-link", { active: isHome }]}
				aria-current={isHome ? "page" : undefined}
			>
				Home
			</a>

			<a
				href="/blog"
				class:list={["nav-link", { active: isRead }]}
				aria-current={isRead ? "page" : undefined}
			>
				Read
			</a>

			<a
				href="/watch"
				class:list={["nav-link", { active: isWatch }]}
				aria-current={isWatch ? "page" : undefined}
			>
				Watch
			</a>

		</div>


		<!-- =========================================
		     RIGHT — SOCIAL ICONS
		========================================= -->

		<div class="social-links">

			<!-- YOUTUBE -->

			<a
				href={socialLinks.youtube}
				target="_blank"
				rel="noopener noreferrer"
				class="social-icon-btn"
				aria-label="Scene and Opinion on YouTube"
			>
				<svg
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8Z"
						fill="currentColor"
					/>

					<path
						d="m9.6 15.6 6.3-3.6-6.3-3.6v7.2Z"
						fill="#111"
					/>
				</svg>
			</a>


			<!-- INSTAGRAM -->

			<a
				href={socialLinks.instagram}
				target="_blank"
				rel="noopener noreferrer"
				class="social-icon-btn"
				aria-label="Scene and Opinion on Instagram"
			>
				<svg
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<rect
						x="3"
						y="3"
						width="18"
						height="18"
						rx="5"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					/>

					<circle
						cx="12"
						cy="12"
						r="4"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					/>

					<circle
						cx="17.5"
						cy="6.5"
						r="1"
						fill="currentColor"
					/>
				</svg>
			</a>


			<!-- EMAIL -->

			<a
				href={socialLinks.email}
				class="social-icon-btn"
				aria-label="Email Scene and Opinion"
			>
				<svg
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<rect
						x="3"
						y="5"
						width="18"
						height="14"
						rx="2"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					/>

					<path
						d="m4 7 8 6 8-6"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</a>

		</div>

	</nav>
</header>


<style>
	/* =========================================
	   HEADER
	========================================= */

	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;

		width: 100%;

		background: rgba(8, 12, 20, 0.97);

		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);

		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	}


	/* =========================================
	   NAVBAR
	========================================= */

	.navbar {
		width: 100%;
		max-width: 1550px;

		height: 92px;

		margin: 0 auto;

		padding: 0 42px;

		display: grid;
		grid-template-columns: 1fr auto 1fr;

		align-items: center;

		gap: 50px;

		box-sizing: border-box;
	}


	/* =========================================
	   BRAND
	========================================= */

	.brand {
		display: flex;
		align-items: center;

		gap: 16px;

		min-width: 0;

		justify-self: start;

		color: #ffffff;

		text-decoration: none;
	}

	.brand:hover {
		text-decoration: none;
	}


	.logo-wrapper {
		width: 54px;
		height: 54px;

		flex: 0 0 54px;

		display: flex;
		align-items: center;
		justify-content: center;

		overflow: hidden;

		border-radius: 12px;
	}


	.logo {
		width: 100%;
		height: 100%;

		object-fit: contain;

		display: block;
	}


	.brand-text {
		display: flex;
		flex-direction: column;
		justify-content: center;

		min-width: 0;
	}


	.brand-name {
		font-family: "Plus Jakarta Sans", sans-serif;

		font-size: 18px;
		font-weight: 700;

		line-height: 1.2;

		letter-spacing: -0.3px;

		color: #ffffff;

		white-space: nowrap;
	}


	.brand-tagline {
		margin-top: 5px;

		font-family: "Plus Jakarta Sans", sans-serif;

		font-size: 11px;
		font-weight: 500;

		line-height: 1.2;

		color: #8d99aa;

		white-space: nowrap;
	}


	/* =========================================
	   NAVIGATION
	========================================= */

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: center;

		gap: 44px;
	}


	.nav-link {
		font-family: "Plus Jakarta Sans", sans-serif;

		font-size: 15px;
		font-weight: 600;

		color: #9ba6b7;

		text-decoration: none;

		padding: 10px 4px;

		transition: color 0.2s ease;
	}


	/* Remove underline completely */

	.nav-link::after {
		display: none !important;
		content: none !important;
	}


	.nav-link:hover {
		color: #ffffff;

		text-decoration: none;
	}


	.nav-link.active {
		color: #ffffff;

		font-weight: 700;

		text-decoration: none;
	}


	.nav-link.active::after {
		display: none !important;
		content: none !important;
	}


	/* =========================================
	   SOCIAL ICONS
	========================================= */

	.social-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;

		gap: 12px;
	}


	.social-icon-btn {
		width: 42px;
		height: 42px;

		display: flex;
		align-items: center;
		justify-content: center;

		color: #cbd5e1;

		text-decoration: none;

		border-radius: 10px;

		transition:
			color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}


	.social-icon-btn:hover {
		color: #ffffff;

		background: rgba(255, 255, 255, 0.07);

		transform: translateY(-1px);
	}


	.social-icon-btn svg {
		width: 23px;
		height: 23px;

		display: block;
	}


	/* =========================================
	   LARGE DESKTOP
	========================================= */

	@media (min-width: 1400px) {

		.navbar {
			height: 94px;

			padding: 0 55px;

			gap: 55px;
		}


		.logo-wrapper {
			width: 55px;
			height: 55px;

			flex-basis: 55px;
		}


		.brand-name {
			font-size: 19px;
		}


		.brand-tagline {
			font-size: 11px;
		}


		.nav-links {
			gap: 48px;
		}


		.nav-link {
			font-size: 15px;
		}


		.social-icon-btn {
			width: 44px;
			height: 44px;
		}


		.social-icon-btn svg {
			width: 24px;
			height: 24px;
		}
	}


	/* =========================================
	   TABLET
	========================================= */

	@media (max-width: 1000px) {

		.navbar {
			height: 86px;

			padding: 0 28px;

			gap: 30px;
		}


		.logo-wrapper {
			width: 50px;
			height: 50px;

			flex-basis: 50px;
		}


		.brand-name {
			font-size: 17px;
		}


		.brand-tagline {
			font-size: 10px;
		}


		.nav-links {
			gap: 28px;
		}


		.nav-link {
			font-size: 14px;
		}
	}


	/* =========================================
	   MOBILE
	========================================= */

	@media (max-width: 650px) {

		.navbar {
			height: 88px;

			padding: 0 18px;

			grid-template-columns: auto 1fr auto;

			gap: 16px;
		}


		.logo-wrapper {
			width: 50px;
			height: 50px;

			flex-basis: 50px;

			border-radius: 12px;
		}


		/* Keep brand visible on normal mobile */

		.brand-text {
			display: flex;
		}


		.brand-name {
			font-size: 16px;
		}


		.brand-tagline {
			font-size: 9px;

			margin-top: 4px;
		}


		.nav-links {
			gap: 17px;
		}


		.nav-link {
			font-size: 12px;

			padding: 8px 0;
		}


		.social-links {
			gap: 2px;
		}


		.social-icon-btn {
			width: 34px;
			height: 34px;
		}


		.social-icon-btn svg {
			width: 19px;
			height: 19px;
		}
	}


	/* =========================================
	   SMALL MOBILE
	========================================= */

	@media (max-width: 480px) {

		.navbar {
			height: 84px;

			padding: 0 14px;

			gap: 11px;
		}


		.logo-wrapper {
			width: 46px;
			height: 46px;

			flex-basis: 46px;
		}


		/* Hide text only on smaller phones */

		.brand-text {
			display: none;
		}


		.nav-links {
			gap: 16px;
		}


		.nav-link {
			font-size: 12px;
		}


		.social-icon-btn {
			width: 32px;
			height: 32px;
		}


		.social-icon-btn svg {
			width: 18px;
			height: 18px;
		}
	}


	/* =========================================
	   VERY SMALL PHONES
	========================================= */

	@media (max-width: 360px) {

		.navbar {
			height: 78px;

			padding: 0 10px;

			gap: 7px;
		}


		.logo-wrapper {
			width: 42px;
			height: 42px;

			flex-basis: 42px;
		}


		.nav-links {
			gap: 11px;
		}


		.nav-link {
			font-size: 11px;
		}


		.social-icon-btn {
			width: 29px;
			height: 29px;
		}


		.social-icon-btn svg {
			width: 16px;
			height: 16px;
		}
	}
</style>