---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

// Fetch all blog posts dynamically from your Astro Content Collection
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 6 Carousel Posters Data (Replace image and link URLs with your own)
const featuredPosters = [
  { 
    title: "Jana Nayagan", 
    image: "https://via.placeholder.com/200x300/10172a/ffffff?text=Jana+Nayagan", 
    link: "/blog/jana-nayagan" 
  },
  { 
    title: "Lenin", 
    image: "https://via.placeholder.com/200x300/10172a/ffffff?text=Lenin", 
    link: "/blog/lenin" 
  },
  { 
    title: "Evil Dead Burn", 
    image: "https://via.placeholder.com/200x300/10172a/ffffff?text=Evil+Dead", 
    link: "/blog/evil-dead-burn" 
  },
  { 
    title: "Mukhbir", 
    image: "https://via.placeholder.com/200x300/10172a/ffffff?text=Mukhbir", 
    link: "/blog/mukhbir" 
  },
  { 
    title: "Dark Light", 
    image: "https://via.placeholder.com/200x300/10172a/ffffff?text=Dark+Light", 
    link: "/blog/dark-light" 
  },
  { 
    title: "Vanda Devullu", 
    image: "https://via.placeholder.com/200x300/10172a/ffffff?text=Vanda+Devullu", 
    link: "/blog/vanda-devullu" 
  }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="read-container">
			
			<!-- 6-IMAGE CAROUSEL SECTION -->
			<section class="carousel-wrapper">
				<button class="nav-btn prev" id="scrollLeft" aria-label="Scroll Left">&#10094;</button>

				<div class="carousel-track" id="carouselTrack">
					{featuredPosters.map((poster) => (
						<a href={poster.link} class="carousel-card" title={poster.title}>
							<img src={poster.image} alt={poster.title} loading="lazy" />
						</a>
					))}
				</div>

				<button class="nav-btn next" id="scrollRight" aria-label="Scroll Right">&#10095;</button>
			</section>

			<!-- 4 ROWS OF READ POSTS -->
			<section class="posts-grid">
				{posts.slice(0, 4).map((post) => (
					<a href={`/blog/${post.slug}/`} class="post-card">
						<div class="post-image-container">
							<img src={post.data.heroImage} alt={post.data.title} class="post-image" loading="lazy" />
						</div>
						<h2 class="post-title">{post.data.title}</h2>
						<span class="post-date">
							<FormattedDate date={post.data.pubDate} />
						</span>
					</a>
				))}
			</section>

		</main>
		<Footer />

		<script>
			const track = document.getElementById('carouselTrack');
			const leftBtn = document.getElementById('scrollLeft');
			const rightBtn = document.getElementById('scrollRight');

			leftBtn?.addEventListener('click', () => {
				track?.scrollBy({ left: -220, behavior: 'smooth' });
			});

			rightBtn?.addEventListener('click', () => {
				track?.scrollBy({ left: 220, behavior: 'smooth' });
			});
		</script>

		<style>
			/* Centered main container matching Scene and Opinion layout */
			.read-container {
				max-width: 680px;
				margin: 0 auto;
				padding: 2rem 1rem;
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

			/* ---------------- 6 CAROUSEL POSTERS ---------------- */
			.carousel-wrapper {
				position: relative;
				width: 100%;
				background: #0d1527;
				border: 1px solid #1a2642;
				border-radius: 12px;
				padding: 0.75rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
			}

			.carousel-track {
				display: flex;
				gap: 0.65rem;
				overflow-x: auto;
				scroll-behavior: smooth;
				scrollbar-width: none; /* Firefox */
			}

			.carousel-track::-webkit-scrollbar {
				display: none; /* Chrome & Safari */
			}

			.carousel-card {
				flex: 0 0 calc((100% - (5 * 0.65rem)) / 6);
				min-width: 85px;
				aspect-ratio: 2 / 3;
				border-radius: 6px;
				overflow: hidden;
				border: 1px solid #1f2d4e;
				transition: transform 0.25s ease, border-color 0.25s ease;
			}

			.carousel-card:hover {
				transform: translateY(-4px) scale(1.03);
				border-color: #3b82f6;
			}

			.carousel-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.nav-btn {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				background: rgba(0, 0, 0, 0.85);
				color: #fff;
				border: 1px solid #334155;
				width: 28px;
				height: 28px;
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 10;
				font-size: 0.8rem;
				transition: background 0.2s, transform 0.2s;
			}

			.nav-btn:hover {
				background: rgba(0, 0, 0, 1);
				transform: translateY(-50%) scale(1.1);
			}

			.nav-btn.prev { left: -10px; }
			.nav-btn.next { right: -10px; }

			/* ---------------- 4 POST ROWS ---------------- */
			.posts-grid {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.post-card {
				background: #0d1527;
				border: 1px solid #1a2642;
				border-radius: 12px;
				padding: 1.25rem;
				text-decoration: none;
				color: #ffffff;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				transition: border-color 0.2s, transform 0.2s;
			}

			.post-card:hover {
				border-color: #3b82f6;
				transform: translateY(-2px);
			}

			.post-image-container {
				width: 100%;
				height: 240px;
				border-radius: 8px;
				overflow: hidden;
				background-color: #152037;
				margin-bottom: 0.75rem;
			}

			.post-image {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.post-title {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0.25rem 0;
			}

			.post-date {
				font-size: 0.8rem;
				color: #94a3b8;
			}
		</style>
	</body>
</html>