---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const reviewPosters = [
	{ primary: '/poster1.png', fallback: '/poster1.jpg' },
	{ primary: '/poster2.png', fallback: '/poster2.jpg' },
	{ primary: '/poster3.png', fallback: '/poster3.jpg' },
	{ primary: '/poster4.png', fallback: '/poster4.jpg' },
	{ primary: '/poster5.png', fallback: '/poster5.jpg' },
	{ primary: '/poster6.png', fallback: '/poster6.jpg' }
];

const socialLinks = {
	instagram: "https://instagram.com/zoomout_says",
	youtube: "https://youtube.com/@zoomout_says",
	email: "mailto:contact@sceneandopinion.com"
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Read | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: #0b132b;
				color: #ffffff;
				font-family: system-ui, -apple-system, sans-serif;
				margin: 0;
			}

			.desktop-view { display: block; }
			.mobile-view { display: none; }

			@media (max-width: 768px) {
				.desktop-view { display: none !important; }
				.mobile-view { display: block !important; }
			}

			/* DESKTOP READ PAGE LAYOUT */
			.read-container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}

			.page-header {
				margin-bottom: 2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				padding-bottom: 1rem;
			}

			.page-title {
				font-size: 2rem;
				color: #ffffff;
				margin: 0 0 0.5rem 0;
			}

			.page-description {
				color: #8b949e;
				font-size: 1rem;
				margin: 0;
			}

			.grid-3-columns {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}

			.read-article-card {
				display: flex;
				flex-direction: column;
				background: #1c2541;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.08);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}

			.read-article-card:hover {
				transform: translateY(-4px);
				border-color: #58a6ff;
			}

			.article-thumb-wrap {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background-color: #101a36;
			}

			.article-thumb-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.article-body {
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.post-date {
				font-size: 0.8rem;
				color: #8b949e;
			}

			.card-title {
				font-size: 1.1rem;
				font-weight: 600;
				color: #ffffff;
				margin: 0;
				line-height: 1.3;
			}

			.card-excerpt {
				font-size: 0.88rem;
				color: #c9d1d9;
				line-height: 1.4;
				margin: 0;
			}

			/* MOBILE DEDICATED STYLES */
			.mobile-header-bar {
				position: fixed;
				top: 0; left: 0; right: 0;
				background-color: #0d1b2a;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				z-index: 100;
				padding: 0.75rem 1rem;
			}

			.mobile-brand-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.6rem;
			}

			.mobile-brand {
				font-weight: 700;
				font-size: 1.1rem;
				color: #ffffff;
				text-decoration: none;
			}

			.mobile-brand span { color: #58a6ff; }

			.mobile-nav-tabs {
				display: flex;
				gap: 1.25rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				padding-top: 0.5rem;
			}

			.mobile-nav-link {
				color: #8b949e;
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 600;
				padding-bottom: 0.2rem;
			}

			.mobile-nav-link.active {
				color: #58a6ff;
				border-bottom: 2px solid #58a6ff;
			}

			.mobile-main {
				padding: 105px 0.75rem 1.5rem 0.75rem;
			}

			.mobile-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.mobile-read-card {
				display: flex;
				gap: 0.85rem;
				background: #1c2541;
				border-radius: 8px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				border: 1px solid rgba(255, 255, 255, 0.08);
				padding: 0.6rem;
			}

			.mobile-read-thumb {
				width: 110px;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 6px;
				flex-shrink: 0;
			}

			.mobile-read-info {
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.mobile-social-links {
				display: flex;
				justify-content: center;
				gap: 1.25rem;
				margin-bottom: 1rem;
			}

			.mobile-social-links a {
				color: #58a6ff;
				text-decoration: none;
				font-size: 0.85rem;
				font-weight: 500;
			}

			.mobile-footer {
				text-align: center;
				padding: 1.5rem 1rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				font-size: 0.85rem;
				color: #8b949e;
			}
		</style>
	</head>
	<body>

		<!-- DESKTOP VIEW -->
		<div class="desktop-view">
			<Header />

			<div class="read-container">
				<div class="page-header">
					<h1 class="page-title">Articles & Written Reviews</h1>
					<p class="page-description">Detailed breakdowns, film essays, and written reviews.</p>
				</div>

				<div class="grid-3-columns">
					{posts.map((post, index) => {
						const poster = reviewPosters[index % reviewPosters.length];
						return (
							<a href={`/blog/${post.slug}/`} class="read-article-card">
								<div class="article-thumb-wrap">
									<img src={post.data.heroImage || poster.primary} data-fallback={poster.fallback} alt={post.data.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
								</div>
								<div class="article-body">
									<span class="post-date">{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
									<h2 class="card-title">{post.data.title}</h2>
									<p class="card-excerpt">{post.data.description || 'Click to read full analysis and breakdown...'}</p>
								</div>
							</a>
						);
					})}
				</div>
			</div>

			<Footer />
		</div>

		<!-- MOBILE VIEW -->
		<div class="mobile-view">
			<header class="mobile-header-bar">
				<div class="mobile-brand-row">
					<a href="/" class="mobile-brand">SCENE <span>& OPINION</span></a>
					<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" style="color:#58a6ff; font-weight:600; text-decoration:none; font-size:0.85rem;">@zoomout_says</a>
				</div>
				<nav class="mobile-nav-tabs">
					<a href="/" class="mobile-nav-link">Home</a>
					<a href="/blog/" class="mobile-nav-link active">Read</a>
					<a href="/watch/" class="mobile-nav-link">Watch</a>
				</nav>
			</header>

			<main class="mobile-main">
				<h3 style="color:#58a6ff; font-size: 1.05rem; margin-bottom:1rem;">All Articles</h3>
				<div class="mobile-list">
					{posts.map((post, index) => {
						const poster = reviewPosters[index % reviewPosters.length];
						return (
							<a href={`/blog/${post.slug}/`} class="mobile-read-card">
								<img src={post.data.heroImage || poster.primary} data-fallback={poster.fallback} class="mobile-read-thumb" alt={post.data.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
								<div class="mobile-read-info">
									<span class="post-date" style="font-size:0.75rem;">{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
									<h4 class="card-title" style="font-size:0.88rem; margin-top:0.2rem;">{post.data.title}</h4>
								</div>
							</a>
						);
					})}
				</div>
			</main>

			<footer class="mobile-footer">
				<div class="mobile-social-links">
					<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
					<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
					<a href={socialLinks.email}>Email</a>
				</div>
				<p>&copy; {new Date().getFullYear()} Scene & Opinion (@zoomout_says)</p>
			</footer>
		</div>

	</body>
</html>