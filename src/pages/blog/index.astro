---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

// Top 5-slide poster carousel using dedicated public assets
const topCarouselPosters = [
	{ primary: '/poster12.png', fallback: '/poster12.jpg', title: 'Jana Nayagan' },
	{ primary: '/poster13.png', fallback: '/poster13.jpg', title: 'Lenin' },
	{ primary: '/poster14.png', fallback: '/poster14.jpg', title: 'Evil Dead Burn' },
	{ primary: '/poster15.png', fallback: '/poster15.jpg', title: 'Mukhbir' },
	{ primary: '/poster16.png', fallback: '/poster16.jpg', title: 'Dark Light' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Read | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				background-color: #0b132b;
				color: #ffffff;
				font-family: system-ui, -apple-system, sans-serif;
				margin: 0;
			}

			.read-container {
				max-width: 1400px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}

			.section-title {
				font-size: 1.3rem;
				color: #58a6ff;
				margin-bottom: 1rem;
				border-left: 4px solid #58a6ff;
				padding-left: 0.6rem;
			}

			/* 1. Top 5-Slide Poster Carousel Container */
			.carousel-container {
				position: relative;
				display: flex;
				align-items: center;
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 12px;
				padding: 1rem 2.5rem;
				background: #101a36;
				margin-bottom: 2.5rem;
			}

			.poster-grid-top {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1rem;
				width: 100%;
			}

			.top-poster-card {
				display: block;
				position: relative;
				aspect-ratio: 2 / 3;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.1);
				background-color: #1c2541;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}

			.top-poster-card:hover {
				transform: translateY(-4px);
				border-color: #58a6ff;
			}

			.top-poster-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.carousel-nav-btn {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				width: 32px;
				height: 32px;
				background-color: rgba(0, 0, 0, 0.7);
				border: 1px solid rgba(255, 255, 255, 0.3);
				color: #ffffff;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				z-index: 2;
				user-select: none;
			}

			.carousel-nav-btn.prev { left: 0.5rem; }
			.carousel-nav-btn.next { right: 0.5rem; }

			/* 2. Featured Review Hero Section (Fully Clickable Redirect) */
			.featured-hero-link {
				display: block;
				text-decoration: none;
				color: inherit;
				margin-bottom: 3rem;
			}

			.featured-hero {
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				gap: 1.5rem;
				background: #1c2541;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.1);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.featured-hero-link:hover .featured-hero {
				transform: translateY(-3px);
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
				border-color: rgba(88, 166, 255, 0.4);
			}

			.hero-banner-wrap {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background-color: #101a36;
			}

			.hero-banner-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.featured-content {
				padding: 2rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.badge {
				background: #58a6ff;
				color: #0b132b;
				font-weight: bold;
				font-size: 0.75rem;
				padding: 0.25rem 0.6rem;
				border-radius: 4px;
				width: fit-content;
				margin-bottom: 0.75rem;
				text-transform: uppercase;
			}

			.featured-title {
				font-size: 1.8rem;
				margin: 0.5rem 0;
				color: #ffffff;
				line-height: 1.3;
			}

			.featured-hero-link:hover .featured-title {
				color: #58a6ff;
			}

			.post-date {
				font-size: 0.85rem;
				color: #8b949e;
				margin-bottom: 0.75rem;
			}

			.featured-snippet {
				font-size: 0.95rem;
				color: #c9d1d9;
				line-height: 1.5;
				margin: 0;
			}

			/* 3. 5-Column Grid Layout (5 Cards per Row) */
			.grid-5-columns {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1.25rem;
			}

			.article-poster-card {
				display: flex;
				flex-direction: column;
				background: #1c2541;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.08);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}

			.article-poster-card:hover {
				transform: translateY(-4px);
				border-color: #58a6ff;
			}

			.poster-img-wrap {
				width: 100%;
				aspect-ratio: 2 / 3;
				overflow: hidden;
				background-color: #101a36;
			}

			.poster-img-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.card-info {
				padding: 0.85rem;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.card-title {
				font-size: 0.95rem;
				font-weight: 600;
				color: #ffffff;
				margin: 0;
				line-height: 1.3;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.article-poster-card:hover .card-title {
				color: #58a6ff;
			}

			@media (max-width: 1100px) {
				.grid-5-columns, .poster-grid-top {
					grid-template-columns: repeat(3, 1fr);
				}
				.featured-hero { grid-template-columns: 1fr; }
			}

			@media (max-width: 650px) {
				.grid-5-columns, .poster-grid-top {
					grid-template-columns: repeat(2, 1fr);
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<div class="read-container">
			<!-- 1. Top 5-Item Carousel -->
			<h2 class="section-title">Spotlight Releases</h2>
			<div class="carousel-container">
				<button class="carousel-nav-btn prev" aria-label="Previous">&#10094;</button>
				<div class="poster-grid-top">
					{topCarouselPosters.map((item) => (
						<div class="top-poster-card">
							<img 
								src={item.primary} 
								data-fallback={item.fallback} 
								alt={item.title}
								onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}"
							/>
						</div>
					))}
				</div>
				<button class="carousel-nav-btn next" aria-label="Next">&#10095;</button>
			</div>

			<!-- 2. Featured Review Hero Section (Clicking redirects to article) -->
			{featuredPost && (
				<a href={`/blog/${featuredPost.slug}/`} class="featured-hero-link">
					<div class="featured-hero">
						<div class="hero-banner-wrap">
							<img 
								src={featuredPost.data.heroImage || '/poster7.png'} 
								alt={featuredPost.data.title}
								onerror="this.src='/poster7.png'" 
							/>
						</div>
						<div class="featured-content">
							<span class="badge">Featured Review</span>
							<h1 class="featured-title">{featuredPost.data.title}</h1>
							<span class="post-date">
								{featuredPost.data.pubDate.toLocaleDateString('en-us', {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
								})}
							</span>
							<p class="featured-snippet">
								{featuredPost.data.description || 'Read our full in-depth review and cinematic analysis...'}
							</p>
						</div>
					</div>
				</a>
			)}

			<!-- 3. Articles Displayed in a 5-Column Grid -->
			<h2 class="section-title">All Reviews & Articles</h2>
			<div class="grid-5-columns">
				{remainingPosts.map((post, index) => {
					const posterNum = 17 + (index % 10);
					return (
						<a href={`/blog/${post.slug}/`} class="article-poster-card">
							<div class="poster-img-wrap">
								<img 
									src={post.data.heroImage || `/poster${posterNum}.png`} 
									data-fallback={`/poster${posterNum}.jpg`}
									alt={post.data.title} 
									onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}"
								/>
							</div>
							<div class="card-info">
								<span class="post-date">
									{post.data.pubDate.toLocaleDateString('en-us', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</span>
								<h3 class="card-title">{post.data.title}</h3>
							</div>
						</a>
					);
				})}
			</div>
		</div>

		<Footer />
	</body>
</html>