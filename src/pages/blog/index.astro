---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const socialLinks = {
	youtube: "https://www.youtube.com/@Sceneandopinion",
	instagram: "https://www.instagram.com/sceneandopinion/",
	email: "mailto:sceneandopinion69@gmail.com"
};

const carouselItems = [
	{ title: 'Poster 1', image: '/poster1.png', fallback: '/poster1.jpg' },
	{ title: 'Poster 2', image: '/poster2.png', fallback: '/poster2.jpg' },
	{ title: 'Poster 3', image: '/poster3.png', fallback: '/poster3.jpg' },
	{ title: 'Poster 4', image: '/poster4.png', fallback: '/poster4.jpg' },
	{ title: 'Poster 5', image: '/poster5.png', fallback: '/poster5.jpg' },
	{ title: 'Poster 6', image: '/poster6.png', fallback: '/poster6.jpg' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Read | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--bg-main: #060e20;
				--bg-nav: #081226;
				--bg-card: #0b1730;
				--accent-blue: #3b82f6;
				--text-light: #ffffff;
				--text-muted: #94a3b8;
				--border-color: rgba(255, 255, 255, 0.08);
			}

			* {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-main);
				color: var(--text-light);
				font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				margin: 0;
				padding: 0;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			/* HEADER WITH TOP-LEFT LOGO */
			.navbar {
				background-color: var(--bg-nav);
				border-bottom: 1px solid var(--border-color);
				padding: 0.85rem 2.5rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.brand-container {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.brand-logo-img {
				height: 48px;
				width: 48px;
				object-fit: contain;
				background-color: #ffffff;
				border-radius: 8px;
				padding: 3px;
				flex-shrink: 0;
			}

			.brand-text-wrap {
				display: flex;
				flex-direction: column;
			}

			.brand-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: #ffffff;
				line-height: 1.2;
			}

			.brand-caption {
				font-size: 0.85rem;
				color: #a0aec0;
				margin-top: 0.15rem;
			}

			.nav-links {
				display: flex;
				gap: 2rem;
				align-items: center;
			}

			.nav-link {
				font-size: 0.95rem;
				font-weight: 600;
				color: #cbd5e1;
				transition: color 0.2s;
			}

			.nav-link:hover {
				color: #ffffff;
			}

			.nav-link.active {
				color: #ffffff;
				font-weight: 700;
				border-bottom: 2px solid #ffffff;
				padding-bottom: 0.2rem;
			}

			.header-socials {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.social-icon-btn {
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0.9;
				transition: opacity 0.2s;
			}

			.social-icon-btn:hover {
				opacity: 1;
			}

			/* MAIN CONTAINER */
			.read-container {
				max-width: 650px;
				margin: 2.5rem auto;
				padding: 0 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			/* TOP CAROUSEL */
			.carousel-wrapper {
				background-color: rgba(255, 255, 255, 0.02);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 0.75rem 1rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.carousel-btn {
				background: none;
				border: none;
				color: #ffffff;
				font-size: 1.1rem;
				cursor: pointer;
				padding: 0.25rem 0.5rem;
				opacity: 0.7;
			}

			.carousel-btn:hover {
				opacity: 1;
			}

			.carousel-track {
				display: grid;
				grid-template-columns: repeat(6, 1fr);
				gap: 0.6rem;
				flex-grow: 1;
			}

			.carousel-item {
				aspect-ratio: 2 / 3;
				border: 1px solid var(--border-color);
				border-radius: 4px;
				overflow: hidden;
				background-color: var(--bg-card);
			}

			.carousel-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			/* POSTS FEED */
			.post-feed {
				display: flex;
				flex-direction: column;
				gap: 1.75rem;
			}

			.post-card {
				background-color: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				overflow: hidden;
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				transition: border-color 0.2s;
			}

			.post-card:hover {
				border-color: var(--accent-blue);
			}

			.post-banner-area {
				width: 100%;
				aspect-ratio: 16 / 9;
				background-color: #081022;
				border-radius: 6px;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-bottom: 1.25rem;
			}

			.post-banner-area img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.post-title {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--accent-blue);
				margin: 0 0 0.4rem 0;
			}

			.post-title:hover {
				text-decoration: underline;
			}

			.post-date {
				font-size: 0.8rem;
				color: var(--text-muted);
				margin: 0;
			}

			/* RESPONSIVE */
			@media (max-width: 650px) {
				.navbar {
					flex-direction: column;
					gap: 1rem;
					padding: 1rem;
					align-items: flex-start;
				}
			}
		</style>
	</head>
	<body>

		<!-- NAVBAR -->
		<header class="navbar">
			<div class="brand-container">
				<img src="/logo.png" alt="Scene and Opinion Logo" class="brand-logo-img" />
				<div class="brand-text-wrap">
					<a href="/" class="brand-title">Scene and Opinion</a>
					<span class="brand-caption">Fresh reviews before the popcorn cools!</span>
				</div>
			</div>

			<nav class="nav-links">
				<a href="/" class="nav-link">Home</a>
				<a href="/blog" class="nav-link active">Read</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="nav-link">Watch</a>
			</nav>

			<div class="header-socials">
				<a href={socialLinks.email} class="social-icon-btn" aria-label="Email">
					<svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
				</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="YouTube">
					<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
				</a>
				<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Instagram">
					<svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
				</a>
			</div>
		</header>

		<!-- READ PAGE MAIN -->
		<main class="read-container">

			<!-- CAROUSEL BAR -->
			<div class="carousel-wrapper">
				<button class="carousel-btn" aria-label="Previous">&lt;</button>
				<div class="carousel-track">
					{carouselItems.map((item) => (
						<div class="carousel-item">
							<img src={item.image} alt={item.title} onerror={`this.src='${item.fallback}'`} />
						</div>
					))}
				</div>
				<button class="carousel-btn" aria-label="Next">&gt;</button>
			</div>

			<!-- POSTS LIST -->
			<div class="post-feed">
				{posts.map((post) => (
					<article class="post-card">
						<div class="post-banner-area">
							{post.data.heroImage && (
								<img src={post.data.heroImage} alt={post.data.title} />
							)}
						</div>
						<a href={`/blog/${post.slug}/`} class="post-title">{post.data.title}</a>
						<p class="post-date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</article>
				))}
			</div>

		</main>

	</body>
</html>