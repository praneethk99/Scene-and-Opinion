---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

// Fetch all markdown blog posts dynamically
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Fallback poster collection for posts that don't have multiple gallery images
const fallbackPosters = ['/poster1.jpg', '/poster2.jpg', '/poster3.jpg', '/poster4.jpg', '/poster5.jpg', '/poster6.jpg'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Read - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			/* Force dark background across global body & wrapper elements */
			html, body, main {
				background-color: #0b132b !important;
				background: #0b132b linear-gradient(180deg, #0b132b 0%, #1c2541 100%) fixed !important;
				color: #f0f6fc !important;
				margin: 0;
				padding: 0;
				width: 100%;
				max-width: 100vw;
				overflow-x: hidden;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
			}
		</style>
		<style>
			*, *::before, *::after {
				box-sizing: border-box;
			}

			.read-container {
				width: 100%;
				max-width: 850px;
				margin: 0 auto;
				padding: 2rem 1rem 4rem 1rem;
			}

			.articles-grid {
				display: flex;
				flex-direction: column;
				gap: 3rem;
				width: 100%;
			}

			.article-card {
				width: 100%;
				background: rgba(15, 23, 42, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 16px;
				padding: 1.25rem;
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
			}

			.carousel-wrapper {
				position: relative;
				width: 100%;
				overflow: hidden;
				border-radius: 12px;
				background-color: #000;
			}

			.carousel-track {
				display: flex;
				width: 100%;
				transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
				will-change: transform;
			}

			.carousel-slide-link {
				min-width: 100%;
				width: 100%;
				display: block;
				flex-shrink: 0;
			}

			.carousel-slide {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				display: block;
				border-radius: 12px;
			}

			.carousel-dots {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 8px;
				margin-top: 1rem;
			}

			.dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background-color: rgba(255, 255, 255, 0.3);
				cursor: pointer;
				transition: all 0.3s ease;
			}

			.dot.active {
				background-color: #58a6ff;
				width: 22px;
				border-radius: 6px;
				box-shadow: 0 0 8px rgba(88, 166, 255, 0.6);
			}

			.article-info {
				text-align: center;
				padding-top: 1.2rem;
			}

			.article-title {
				font-size: 1.75rem;
				font-weight: 700;
				margin: 0 0 0.5rem 0;
			}

			.article-title a {
				color: #ffffff !important;
				text-decoration: none;
			}

			.article-title a:hover {
				color: #58a6ff !important;
			}

			.article-date {
				font-size: 0.9rem;
				color: #8b949e !important;
				margin: 0;
			}

			@media (max-width: 640px) {
				.read-container {
					padding: 1rem 0.75rem 2rem 0.75rem;
				}
				.carousel-slide {
					aspect-ratio: 4 / 3;
				}
				.article-title {
					font-size: 1.3rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="read-container">
			<div class="articles-grid">
				{posts.map((post, articleIdx) => {
					// Use post heroImage or fallback to sidebar posters for slide demo
					const slideImages = [
						post.data.heroImage || fallbackPosters[articleIdx % fallbackPosters.length],
						fallbackPosters[(articleIdx + 1) % fallbackPosters.length],
						fallbackPosters[(articleIdx + 2) % fallbackPosters.length]
					];

					return (
						<article class="article-card">
							<div class="carousel-wrapper">
								<div class="carousel-track" id={`track-${articleIdx}`}>
									{slideImages.map((imgSrc, imgIdx) => (
										<a href={`/blog/${post.slug}/`} class="carousel-slide-link">
											<img 
												src={imgSrc} 
												alt={`${post.data.title} slide ${imgIdx + 1}`} 
												class="carousel-slide" 
											/>
										</a>
									))}
								</div>
							</div>

							<div class="carousel-dots" id={`dots-${articleIdx}`}>
								{slideImages.map((_, imgIdx) => (
									<span 
										class={`dot ${imgIdx === 0 ? 'active' : ''}`} 
										data-index={imgIdx}
									></span>
								))}
							</div>

							<div class="article-info">
								<h2 class="article-title">
									<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
								</h2>
								<p class="article-date">
									{post.data.pubDate.toLocaleDateString('en-us', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</p>
							</div>
						</article>
					);
				})}
			</div>
		</main>

		<Footer />

		<script>
			document.querySelectorAll('.article-card').forEach((card, articleIdx) => {
				const track = document.getElementById(`track-${articleIdx}`) as HTMLElement;
				const dots = card.querySelectorAll('.dot');
				const totalSlides = dots.length;
				let currentIndex = 0;

				function updateSlide(index: number) {
					currentIndex = index;
					if (track) {
						track.style.transform = `translateX(-${currentIndex * 100}%)`;
					}
					dots.forEach((dot, i) => {
						dot.classList.toggle('active', i === currentIndex);
					});
				}

				setInterval(() => {
					const nextIndex = (currentIndex + 1) % totalSlides;
					updateSlide(nextIndex);
				}, 4000);

				dots.forEach((dot) => {
					dot.addEventListener('click', (e) => {
						const target = e.target as HTMLElement;
						const index = parseInt(target.getAttribute('data-index') || '0', 10);
						updateSlide(index);
					});
				});
			});
		</script>
	</body>
</html>