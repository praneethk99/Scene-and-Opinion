---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import reviewsData from '../../data/reviews.json';

export async function getStaticPaths({ paginate }) {
	// Map your reviews dynamically from your JSON data source
	const validArticles = reviewsData.map((review) => ({
		title: review.title,
		snippet: review.snippet,
		image: review.image,
		fallback: review.image,
		url: `/blog/${review.slug}`
	}));

	return paginate(validArticles, { pageSize: 20 });
}

const { page } = Astro.props;

const socialLinks = {
	youtube: "https://www.youtube.com/@Sceneandopinion",
	instagram: "https://www.instagram.com/sceneandopinion/",
	email: "mailto:sceneandopinion69@gmail.com"
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Reviews (Page ${page.currentPage}) - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">

		<style>
			:root {
				--bg-main: #060e20;
				--bg-nav: #081226;
				--bg-card: #0d1933;
				--accent-blue: #3b82f6;
				--text-light: #ffffff;
				--text-muted: #94a3b8;
				--border-color: rgba(255, 255, 255, 0.08);
			}

			* { box-sizing: border-box; }

			body {
				background-color: var(--bg-main);
				color: var(--text-light);
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				margin: 0;
				padding: 0;
			}

			a { color: inherit; text-decoration: none; }

			/* NAVBAR */
			.navbar {
				background-color: var(--bg-nav);
				border-bottom: 1px solid var(--border-color);
				padding: 0.75rem 2.5rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.brand-container {
				display: flex;
				align-items: center;
				gap: 1rem;
				justify-self: start;
			}

			.brand-logo-img {
				height: 56px;
				width: 56px;
				object-fit: contain;
				background-color: #ffffff;
				border-radius: 8px;
				padding: 4px;
				flex-shrink: 0;
			}

			.brand-text-wrap { display: flex; flex-direction: column; }
			.brand-title { font-size: 1.25rem; font-weight: 700; color: #ffffff; line-height: 1.2; }
			.brand-caption { font-size: 0.8rem; color: #a0aec0; margin-top: 0.1rem; }

			.nav-links {
				display: flex;
				gap: 2rem;
				align-items: center;
				justify-self: center;
			}

			.nav-link { font-size: 1rem; font-weight: 600; color: #cbd5e1; transition: color 0.2s; }
			.nav-link:hover { color: #ffffff; }
			.nav-link.active { color: #ffffff; font-weight: 700; border-bottom: 2px solid #ffffff; padding-bottom: 0.15rem; }

			.header-socials { display: flex; align-items: center; gap: 1rem; justify-self: end; }
			.social-icon-btn { color: #ffffff; display: flex; align-items: center; justify-content: center; opacity: 0.9; transition: opacity 0.2s, transform 0.2s; }
			.social-icon-btn svg { width: 24px; height: 24px; }
			.social-icon-btn:hover { opacity: 1; transform: scale(1.1); }

			/* MAIN CONTAINER */
			.main-container {
				max-width: 1350px;
				margin: 1.5rem auto;
				padding: 0 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			/* ARTICLES GRID */
			.articles-section { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1rem; }
			
			/* SECTION HEADING WITH UNDERLINE */
			.section-heading-wrapper {
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 2px solid var(--border-color);
				padding-bottom: 0.75rem;
			}

			.section-heading-title {
				font-size: 1.5rem;
				font-weight: 800;
				color: #ffffff;
				margin: 0;
			}

			.page-indicator { font-size: 0.9rem; color: var(--text-muted); font-weight: 500; }
			
			.articles-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.25rem;
			}

			.article-card {
				background-color: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 10px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.article-card:hover {
				transform: translateY(-4px);
				border-color: var(--accent-blue);
				box-shadow: 0 8px 20px rgba(59, 130, 246, 0.2);
			}

			.article-image-wrap { width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background-color: #040812; }
			.article-image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
			.article-card:hover .article-image-wrap img { transform: scale(1.05); }

			.article-info { padding: 1rem; display: flex; flex-direction: column; gap: 0.4rem; flex-grow: 1; }
			.article-title { font-size: 1.05rem; font-weight: 700; color: #ffffff; margin: 0; line-height: 1.3; }
			.article-snippet { font-size: 0.82rem; color: var(--text-muted); line-height: 1.4; margin: 0; }

			/* PAGINATION CONTROLS */
			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 1rem;
				margin-top: 2rem;
				padding-bottom: 1rem;
			}

			.page-btn {
				background-color: var(--bg-card);
				color: #ffffff;
				border: 1px solid var(--border-color);
				padding: 0.6rem 1.2rem;
				border-radius: 8px;
				font-weight: 600;
				font-size: 0.95rem;
				transition: all 0.2s ease;
			}

			.page-btn:hover:not(.disabled) {
				background-color: var(--accent-blue);
				border-color: var(--accent-blue);
			}

			.page-btn.disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}

			.page-info-text {
				color: var(--text-muted);
				font-size: 0.95rem;
				font-weight: 600;
			}

			/* FOOTER */
			.site-footer {
				background-color: var(--bg-nav);
				border-top: 1px solid var(--border-color);
				padding: 2rem 2.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.4rem;
				text-align: center;
				margin-top: 4rem;
			}

			.footer-copyright {
				font-size: 0.85rem;
				color: #94a3b8;
				margin: 0;
			}

			.footer-brand {
				font-size: 0.95rem;
				font-weight: 800;
				color: #ffffff;
				letter-spacing: 0.05em;
				margin: 0;
			}

			.footer-email {
				font-size: 0.9rem;
				color: var(--accent-blue);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: 0.2rem;
				transition: opacity 0.2s;
			}

			.footer-email:hover {
				opacity: 0.85;
				text-decoration: underline;
			}

			.footer-mail-icon {
				width: 18px;
				height: 18px;
				color: currentColor;
			}

			@media (max-width: 1024px) {
				.articles-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 600px) {
				.navbar { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; align-items: flex-start; }
				.articles-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>

		<header class="navbar">
			<div class="brand-container">
				<img src="/logo.png" alt="Scene and Opinion Logo" class="brand-logo-img" onerror="if (this.src.endsWith('.png')) { this.src = '/logo.jpg'; }" />
				<div class="brand-text-wrap">
					<a href="/" class="brand-title">Scene and Opinion</a>
					<span class="brand-caption">Fresh reviews before the popcorn cools!</span>
				</div>
			</div>

			<nav class="nav-links">
				<a href="/" class="nav-link">Home</a>
				<a href="/blog" class="nav-link active">Read</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="nav-link">Watch</a>
			</nav>

			<div class="header-socials">
				<a href={socialLinks.email} class="social-icon-btn" aria-label="Email">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
				</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="YouTube">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
				</a>
				<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
				</a>
			</div>
		</header>

		<main class="main-container">
			<section class="articles-section">
				<div class="section-heading-wrapper">
					<h2 class="section-heading-title">Reviews</h2>
					<span class="page-indicator">Page {page.currentPage} of {page.lastPage}</span>
				</div>

				<div class="articles-grid">
					{page.data.map((item) => (
						<a href={item.url} class="article-card">
							<div class="article-image-wrap">
								<img src={item.image} alt={item.title} onerror={`if (this.src.endsWith('.png')) { this.src = '${item.fallback}'; }`} />
							</div>
							<div class="article-info">
								<h3 class="article-title">{item.title}</h3>
								<p class="article-snippet">{item.snippet}</p>
							</div>
						</a>
					))}
				</div>

				<!-- Pagination Navigation Buttons -->
				<div class="pagination">
					{page.url.prev ? (
						<a href={page.url.prev} class="page-btn">← Previous</a>
					) : (
						<span class="page-btn disabled">← Previous</span>
					)}

					<span class="page-info-text">Page {page.currentPage} / {page.lastPage}</span>

					{page.url.next ? (
						<a href={page.url.next} class="page-btn">Next →</a>
					) : (
						<span class="page-btn disabled">Next →</span>
					)}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<p class="footer-copyright">© All rights reserved.</p>
			<p class="footer-brand">SCENE AND OPINION</p>
			<a href="mailto:sceneandopinion69@gmail.com" class="footer-email">
				<svg viewBox="0 0 24 24" fill="currentColor" class="footer-mail-icon"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
				sceneandopinion69@gmail.com
			</a>
		</footer>

	</body>
</html>