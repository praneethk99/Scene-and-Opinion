			<!-- 3-COLUMN SECTION WITH SIDE PANELS -->
			<div class="main-layout">
				
				<!-- Left Poster Column (3 Posters) -->
				<div class="poster-column">
					{leftPosters.map((poster) => (
						<div class="poster-card">
							<img 
								src={`${poster.base}${poster.formats[0]}`} 
								alt="" 
								data-base={poster.base}
								data-formats={JSON.stringify(poster.formats)}
								data-index="0"
								onerror="
									let formats = JSON.parse(this.getAttribute('data-formats'));
									let currentIndex = parseInt(this.getAttribute('data-index'));
									currentIndex++;
									if (currentIndex < formats.length) {
										this.setAttribute('data-index', currentIndex);
										this.src = this.getAttribute('data-base') + formats[currentIndex];
									}
								" 
							/>
						</div>
					))}
				</div>

				<!-- Center Content Area -->
				<div class="center-content">

					<div class="trending-hub-container">
						{trendingHub.map((hub) => {
							const dynamicFields = Object.entries(hub)
								.filter(([key]) => key !== 'label' && key !== 'title' && key !== 'image' && key !== 'readMoreUrl' && key !== 'tag')
								.map(([key, value]) => {
									let formattedKey = key;
									if (key.startsWith('day')) {
										formattedKey = `Day ${key.replace('day', '')}`;
									} else {
										formattedKey = key.charAt(0).toUpperCase() + key.slice(1);
									}

									const isVerdict = key.toLowerCase().includes('verdict') || key.toLowerCase() === 'verd' || key.toLowerCase() === 'verdi';

									return (
										<span key={key} style={isVerdict ? { fontWeight: '800', color: '#38bdf8' } : {}}>
											{isVerdict ? `Verdict: ${value}` : `${formattedKey}: ${value}`}
										</span>
									);
								});

							return (
								<div class="hub-card">
									<div class="hub-card-content">
										<span class="hub-card-label">{hub.label}</span>
										<span class="hub-card-title">{hub.title}</span>
										<span class="hub-card-sub">{dynamicFields}</span>
										{hub.readMoreUrl && (
											<a href={hub.readMoreUrl} class="read-more-btn">
												Click here to read more →
											</a>
										)}
									</div>
									<div class="hub-card-right-column">
										{hub.image && (
											<a href={hub.readMoreUrl || '#'} class="hub-card-image-wrap">
												<img 
													src={`${hub.image}${imageFormats[0]}`} 
													alt={hub.title} 
													data-base={hub.image}
													data-formats={JSON.stringify(imageFormats)}
													data-index="0"
													onerror="
														let formats = JSON.parse(this.getAttribute('data-formats'));
														let currentIndex = parseInt(this.getAttribute('data-index'));
														currentIndex++;
														if (currentIndex < formats.length) {
															this.setAttribute('data-index', currentIndex);
															this.src = this.getAttribute('data-base') + formats[currentIndex];
														}
													"
												/>
											</a>
										)}
									</div>
								</div>
							);
						})}
					</div>

					<div class="community-features">
						<div class="community-card">
							<span class="community-badge">Cinephile Quote of the Day</span>
							<p class="community-text">{communityFeatures.quoteOfTheDay.text}</p>
							<span class="community-sub">{communityFeatures.quoteOfTheDay.source}</span>
						</div>
						<div class="community-card">
							<span class="community-badge">{communityFeatures.memeOfTheWeek.title}</span>
							<p class="community-text" style="font-style: normal;">{communityFeatures.memeOfTheWeek.caption}</p>
							<span class="community-sub">Community Laughs 🎭</span>
						</div>
					</div>

					<!-- DYNAMIC POLL WIDGET -->
					<div class="poll-container">
						<div class="poll-header">
							<span class="poll-badge">Weekly Audience Poll</span>
							<span class="poll-user-status" id="poll-user-status">Loading votes...</span>
						</div>
						<h3 class="poll-question">{pollData.question}</h3>
						
						<div class="poll-options" id="poll-options-container">
							{pollData.options.map((option) => (
								<button class="poll-option-btn" data-id={option.id}>
									<div class="poll-progress-bar" id={`bar-${option.id}`}></div>
									<div class="poll-left-wrap">
										<div class="poll-check-pill">✓</div>
