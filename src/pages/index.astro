---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const socialLinks = {
	youtube: "https://www.youtube.com/@Sceneandopinion",
	instagram: "https://www.instagram.com/sceneandopinion/",
	email: "mailto:sceneandopinion69@gmail.com"
};

const latestVideos = [
	{ title: 'Kalki 2898 AD', image: '/poster1.png', fallback: '/poster1.jpg', url: socialLinks.youtube },
	{ title: 'Pushpa 2', image: '/poster2.png', fallback: '/poster2.jpg', url: socialLinks.youtube },
	{ title: 'Devara', image: '/poster3.png', fallback: '/poster3.jpg', url: socialLinks.youtube }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
		<style>
			:root {
				--bg-main: #141414;
				--bg-card: #181818;
				--accent-red: #E50914;
				--text-muted: #aaaaaa;
			}

			* {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-main);
				color: #ffffff;
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				margin: 0;
				padding: 0;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			/* NETFLIX-STYLE HEADER */
			.navbar {
				background: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, rgba(20,20,20,0.8) 70%, rgba(20,20,20,0) 100%);
				padding: 1.25rem 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				position: sticky;
				top: 0;
				z-index: 100;
				backdrop-filter: blur(8px);
			}

			.brand-container {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.brand-logo-img {
				height: 48px;
				width: auto;
				object-fit: contain;
			}

			.brand-text-wrap {
				display: flex;
				flex-direction: column;
			}

			.brand-title {
				font-family: 'Bebas Neue', 'Inter', sans-serif;
				font-size: 1.8rem;
				letter-spacing: 1px;
				color: #ffffff;
				line-height: 1;
				text-transform: uppercase;
			}

			.brand-caption {
				font-size: 0.72rem;
				color: var(--accent-red);
				font-weight: 600;
				margin-top: 0.2rem;
				letter-spacing: 0.02em;
			}

			.nav-links {
				display: flex;
				gap: 2rem;
				align-items: center;
			}

			.nav-link {
				font-size: 0.9rem;
				font-weight: 600;
				color: #e5e5e5;
				transition: color 0.2s;
			}

			.nav-link.active, .nav-link:hover {
				color: #ffffff;
			}

			.nav-link.active {
				color: var(--accent-red);
				font-weight: 700;
			}

			.header-socials {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.social-icon-btn {
				color: #e5e5e5;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: color 0.2s, transform 0.2s;
			}

			.social-icon-btn:hover {
				color: var(--accent-red);
				transform: scale(1.1);
			}

			/* PAGE CONTAINER */
			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem 1.5rem;
			}

			/* HERO SECTION */
			.hero-card {
				background-color: var(--bg-card);
				border-radius: 12px;
				padding: 1.5rem;
				display: grid;
				grid-template-columns: 1.2fr 1fr;
				gap: 2rem;
				align-items: center;
				margin-bottom: 3rem;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
			}

			.hero-media {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 8px;
				overflow: hidden;
				background-color: #000000;
			}

			.hero-media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.play-button {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 60px;
				height: 40px;
				background-color: var(--accent-red);
				border-radius: 8px;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
			}

			.play-button::after {
				content: '';
				width: 0;
				height: 0;
				border-top: 8px solid transparent;
				border-bottom: 8px solid transparent;
				border-left: 14px solid #ffffff;
			}

			.hero-content {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}

			.tag {
				background-color: var(--accent-red);
				color: #ffffff;
				font-size: 0.7rem;
				font-weight: 800;
				text-transform: uppercase;
				padding: 0.35rem 0.75rem;
				border-radius: 4px;
				margin-bottom: 1rem;
				letter-spacing: 0.05em;
			}

			.hero-title {
				font-size: 2.2rem;
				font-weight: 800;
				margin: 0 0 1rem 0;
				line-height: 1.2;
			}

			.hero-desc {
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
				margin: 0 0 1.5rem 0;
			}

			.btn-primary {
				background-color: var(--accent-red);
				color: #ffffff;
				font-weight: 700;
				font-size: 0.9rem;
				padding: 0.75rem 1.5rem;
				border-radius: 4px;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				transition: background-color 0.2s, transform 0.2s;
			}

			.btn-primary:hover {
				background-color: #b80710;
				transform: translateY(-2px);
			}

			/* WHAT WE DO SECTION */
			.section-header {
				text-align: center;
				font-size: 1.5rem;
				font-weight: 700;
				margin-bottom: 2rem;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				color: #ffffff;
			}

			.section-header::before, .section-header::after {
				content: '—';
				color: var(--text-muted);
			}

			.features-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
				margin-bottom: 3.5rem;
			}

			.feature-card {
				background-color: var(--bg-card);
				border-radius: 8px;
				padding: 1.5rem;
				display: flex;
				align-items: flex-start;
				gap: 1rem;
			}

			.feature-icon {
				width: 44px;
				height: 44px;
				border-radius: 8px;
				background: rgba(229, 9, 20, 0.15);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--accent-red);
				flex-shrink: 0;
			}

			.feature-title {
				font-size: 1rem;
				font-weight: 700;
				margin: 0 0 0.35rem 0;
			}

			.feature-desc {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin: 0;
			}

			/* LATEST FROM CHANNEL */
			.channel-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.5rem;
			}

			.channel-title {
				font-size: 1.3rem;
				font-weight: 700;
				margin: 0;
			}

			.view-all {
				font-size: 0.85rem;
				color: var(--text-muted);
				font-weight: 600;
			}

			.video-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
				margin-bottom: 3.5rem;
			}

			.video-card {
				background-color: var(--bg-card);
				border-radius: 8px;
				overflow: hidden;
				aspect-ratio: 16 / 9;
				display: block;
				transition: transform 0.2s;
			}

			.video-card:hover {
				transform: scale(1.03);
			}

			.video-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			/* FOOTER */
			.footer-section {
				text-align: center;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				color: var(--text-muted);
				font-size: 0.85rem;
			}

			/* MOBILE STYLES */
			@media (max-width: 768px) {
				.navbar {
					padding: 1rem;
					flex-direction: column;
					align-items: flex-start;
					gap: 0.75rem;
				}

				.header-top-row {
					display: flex;
					width: 100%;
					justify-content: space-between;
					align-items: center;
				}

				.nav-links {
					width: 100%;
					justify-content: space-around;
					border-top: 1px solid rgba(255, 255, 255, 0.1);
					padding-top: 0.5rem;
				}

				.hero-card {
					grid-template-columns: 1fr;
					gap: 1.25rem;
					padding: 1rem;
				}

				.hero-title {
					font-size: 1.6rem;
				}

				.features-grid, .video-grid {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
			}
		</style>
	</head>
	<body>

		<!-- NAVBAR -->
		<header class="navbar">
			<div class="header-top-row" style="width: 100%; display: flex; justify-content: space-between; align-items: center;">
				<div class="brand-container">
					<img src="/logo.png" alt="Scene and Opinion Logo" class="brand-logo-img" onerror="this.style.display='none'" />
					<div class="brand-text-wrap">
						<a href="/" class="brand-title">SCENE AND OPINION</a>
						<span class="brand-caption">Fresh reviews before the popcorn cools !</span>
					</div>
				</div>

				<div class="header-socials">
					<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="YouTube">
						<svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
					</a>
					<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Instagram">
						<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</a>
					<a href={socialLinks.email} class="social-icon-btn" aria-label="Email">
						<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
					</a>
				</div>
			</div>

			<nav class="nav-links">
				<a href="/" class="nav-link active">Home</a>
				<a href="/blog" class="nav-link">Read</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="nav-link">Watch</a>
			</nav>
		</header>

		<main class="container">
			<!-- HERO FEATURED VIDEO CARD -->
			<section class="hero-card">
				<div class="hero-media">
					<img src="/poster12.png" alt="Featured Video" onerror="this.src='/poster12.jpg'" />
					<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="play-button" aria-label="Play Video"></a>
				</div>
				<div class="hero-content">
					<span class="tag">Featured Video</span>
					<h1 class="hero-title">Movie, Music & More</h1>
					<p class="hero-desc">
						Catch daily takes and quick reviews on our Instagram and watch full in-depth video analysis on our YouTube channel.
					</p>
					<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="btn-primary">
						<svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
						Watch Now
					</a>
				</div>
			</section>

			<!-- WHAT WE DO SECTION -->
			<section>
				<h2 class="section-header">What We Do</h2>
				<div class="features-grid">
					<div class="feature-card">
						<div class="feature-icon">
							<svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h18M3 16h18"></path></svg>
						</div>
						<div>
							<h3 class="feature-title">Honest Movie Reviews</h3>
							<p class="feature-desc">Real opinions. No filters.</p>
						</div>
					</div>

					<div class="feature-card">
						<div class="feature-icon">
							<svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
						</div>
						<div>
							<h3 class="feature-title">Deep-Dive Film Breakdowns</h3>
							<p class="feature-desc">Go deeper into your favourite films.</p>
						</div>
					</div>

					<div class="feature-card">
						<div class="feature-icon">
							<svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2"></path></svg>
						</div>
						<div>
							<h3 class="feature-title">Fresh Cinema News & Updates</h3>
							<p class="feature-desc">Stay updated with the latest in the world of cinema.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- LATEST FROM CHANNEL -->
			<section>
				<div class="channel-header">
					<h3 class="channel-title">Latest from the Channel</h3>
					<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="view-all">View All &rarr;</a>
				</div>
				<div class="video-grid">
					{latestVideos.map((video) => (
						<a href={video.url} target="_blank" rel="noopener noreferrer" class="video-card">
							<img src={video.image} alt={video.title} onerror={`this.src='${video.fallback}'`} />
						</a>
					))}
				</div>
			</section>

			<footer class="footer-section">
				<p>&copy; {new Date().getFullYear()} SCENE AND OPINION. All rights reserved.</p>
			</footer>
		</main>

	</body>
</html>