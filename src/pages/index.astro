/* Modern Reset & Box Sizing Baseline */
*, *::before, *::after {
  box-sizing: border-box;
}

/* Prevent horizontal overflow and handle media assets */
img, video, iframe, picture, svg {
  max-width: 100%;
  height: auto;
  display: block; /* Prevents unwanted inline whitespace gap */
}

/* Container safety to prevent overflow across all devices */
html, body {
  max-width: 100%;
  overflow-x: hidden;
}

/* Responsive Container */
main {
  width: 100%;
  max-width: 800px;
  margin-inline: auto; /* Modern logical property for margin left/right */
  padding: clamp(1rem, 3vw, 2rem); /* Fluid padding scaling from 1rem to 2rem */
}

/* Responsive Layout Elements */
header, footer {
  width: 100%;
  padding: 1rem;
}

/* Responsive Typography using Fluid Scaling (clamp) */
h1 {
  font-size: clamp(1.75rem, 5vw, 2.5rem);
  line-height: 1.2;
}

h2 {
  font-size: clamp(1.3rem, 4vw, 1.8rem);
  line-height: 1.3;
}

/* Mobile-Specific Tweaks */
@media (max-width: 600px) {
  header, footer {
    padding: 0.75rem 1rem;
  }
  
  /* Optional: Increases touch target sizing for buttons/links on touch screens */
  button, a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
}