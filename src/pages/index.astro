									</div>
									<span class="poll-option-percent" id={`pct-${option.id}`}>0%</span>
								</button>
							))}
						</div>

						<div class="poll-footer">
							<span id="poll-total-votes">Total Votes: 0</span>
							<span>Live Audience Input</span>
						</div>
					</div>

				</div>

				<!-- Right Poster Column (3 Posters) -->
				<div class="poster-column">
					{rightPosters.map((poster) => (
						<div class="poster-card">
							<img 
								src={`${poster.base}${poster.formats[0]}`} 
								alt="" 
								data-base={poster.base}
								data-formats={JSON.stringify(poster.formats)}
								data-index="0"
								onerror="
									let formats = JSON.parse(this.getAttribute('data-formats'));
									let currentIndex = parseInt(this.getAttribute('data-index'));
									currentIndex++;
									if (currentIndex < formats.length) {
										this.setAttribute('data-index', currentIndex);
										this.src = this.getAttribute('data-base') + formats[currentIndex];
									}
								" 
							/>
