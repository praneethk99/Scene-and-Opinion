---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

// Trending Spotlight Posters
const spotlightPosters = [
	{ primary: '/poster12.png', fallback: '/poster12.jpg', title: 'Jana Nayagan' },
	{ primary: '/poster13.png', fallback: '/poster13.jpg', title: 'Lenin' },
	{ primary: '/poster14.png', fallback: '/poster14.jpg', title: 'Evil Dead Burn' },
	{ primary: '/poster15.png', fallback: '/poster15.jpg', title: 'Mukhbir' },
	{ primary: '/poster16.png', fallback: '/poster16.jpg', title: 'Dark Light' }
];

// All Reviews Posters
const reviewPosters = [
	{ primary: '/poster1.png', fallback: '/poster1.jpg' },
	{ primary: '/poster2.png', fallback: '/poster2.jpg' },
	{ primary: '/poster3.png', fallback: '/poster3.jpg' },
	{ primary: '/poster4.png', fallback: '/poster4.jpg' },
	{ primary: '/poster5.png', fallback: '/poster5.jpg' },
	{ primary: '/poster6.png', fallback: '/poster6.jpg' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | Home`} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

		<style>
			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				background-color: #0b132b;
				color: #ffffff;
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				margin: 0;
				padding-top: 60px;
			}

			h1, h2, h3, h4, .brand-text {
				font-family: 'Poppins', sans-serif;
			}

			/* HEADER */
			.site-header {
				position: fixed;
				top: 0; left: 0; right: 0;
				height: 60px;
				background-color: #0d1b2a;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 1rem;
			}

			.brand-text {
				font-size: 1.1rem;
				font-weight: 700;
				color: #ffffff;
				text-decoration: none;
			}

			.brand-text span {
				color: #58a6ff;
			}

			.nav-menu {
				display: flex;
				gap: 1.5rem;
			}

			.nav-link {
				color: #c9d1d9;
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
			}

			.nav-link.active, .nav-link:hover {
				color: #58a6ff;
			}

			.header-socials {
				display: flex;
				gap: 0.75rem;
			}

			.social-icon {
				color: #8b949e;
				display: flex;
				align-items: center;
			}

			.social-icon:hover {
				color: #58a6ff;
			}

			.mobile-toggle {
				display: none;
				background: none;
				border: none;
				color: #ffffff;
				font-size: 1.5rem;
				cursor: pointer;
			}

			.mobile-drawer {
				display: none;
				position: fixed;
				top: 60px; left: 0; right: 0;
				background-color: #0d1b2a;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				padding: 1.25rem 1rem;
				flex-direction: column;
				gap: 1rem;
				z-index: 99;
			}

			.mobile-drawer.open {
				display: flex;
			}

			/* MAIN CONTENT */
			.main-container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 1.5rem 1rem;
			}

			.section-header {
				border-left: 4px solid #58a6ff;
				padding-left: 0.6rem;
				margin-bottom: 1rem;
			}

			.section-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0;
			}

			/* HERO CARD */
			.hero-wrapper {
				margin-bottom: 2.5rem;
			}

			.hero-card {
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				background: #1c2541;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.1);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease;
			}

			.hero-card:hover {
				transform: translateY(-3px);
			}

			.hero-img-wrap {
				width: 100%;
				aspect-ratio: 16 / 9;
				background-color: #101a36;
			}

			.hero-img-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.hero-info {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.badge {
				background: #58a6ff;
				color: #0b132b;
				font-weight: 700;
				font-size: 0.7rem;
				padding: 0.2rem 0.5rem;
				border-radius: 4px;
				width: fit-content;
				margin-bottom: 0.5rem;
				text-transform: uppercase;
			}

			.hero-title {
				font-size: 1.5rem;
				margin: 0.25rem 0 0.5rem 0;
				line-height: 1.3;
			}

			.post-date {
				font-size: 0.8rem;
				color: #8b949e;
				margin-bottom: 0.5rem;
			}

			/* HORIZONTAL POSTER SCROLL */
			.spotlight-wrapper {
				margin-bottom: 2.5rem;
			}

			.horizontal-scroll-container {
				display: flex;
				gap: 1rem;
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				padding-bottom: 0.75rem;
				-webkit-overflow-scrolling: touch;
				scrollbar-width: none;
			}

			.horizontal-scroll-container::-webkit-scrollbar {
				display: none;
			}

			.poster-card-item {
				flex: 0 0 160px;
				scroll-snap-align: start;
				aspect-ratio: 2 / 3;
				border-radius: 8px;
				overflow: hidden;
				background-color: #1c2541;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}

			.poster-card-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			/* REVIEWS GRID */
			.grid-reviews {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1.25rem;
			}

			.review-item-card {
				display: flex;
				flex-direction: column;
				background: #1c2541;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.08);
				text-decoration: none;
				color: inherit;
			}

			.review-img-wrap {
				width: 100%;
				aspect-ratio: 2 / 3;
				background-color: #101a36;
			}

			.review-img-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.review-card-info {
				padding: 0.75rem;
			}

			.review-card-title {
				font-size: 0.9rem;
				font-weight: 600;
				margin: 0.25rem 0 0 0;
				line-height: 1.3;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* FOOTER */
			.site-footer {
				background-color: #070d1d;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				padding: 2rem 1rem;
				text-align: center;
				margin-top: 3rem;
			}

			.footer-socials {
				display: flex;
				justify-content: center;
				gap: 1.25rem;
				margin-bottom: 1rem;
			}

			.footer-social-link {
				color: #8b949e;
				font-size: 1.25rem;
				text-decoration: none;
			}

			/* MOBILE RESPONSIVE */
			@media (max-width: 1024px) {
				.grid-reviews { grid-template-columns: repeat(3, 1fr); }
				.hero-card { grid-template-columns: 1fr; }
			}

			@media (max-width: 640px) {
				.nav-menu, .header-socials { display: none; }
				.mobile-toggle { display: block; }
				.poster-card-item { flex: 0 0 135px; }
				.grid-reviews { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
				.hero-info { padding: 1rem; }
				.hero-title { font-size: 1.25rem; }
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand-text">SCENE <span>& OPINION</span></a>

			<nav class="nav-menu">
				<a href="/" class="nav-link active">Home</a>
				<a href="/blog" class="nav-link">Read</a>
			</nav>

			<div class="header-socials">
				<a href="https://instagram.com/zoomout_says" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
					<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
				</a>
			</div>

			<button class="mobile-toggle" id="menuToggle">&#9776;</button>
		</header>

		<div class="mobile-drawer" id="mobileDrawer">
			<a href="/" class="nav-link active">Home</a>
			<a href="/blog" class="nav-link">Read</a>
			<a href="https://instagram.com/zoomout_says" target="_blank" rel="noopener noreferrer" class="nav-link">Instagram (@zoomout_says)</a>
		</div>

		<main class="main-container">
			{featuredPost && (
				<div class="hero-wrapper">
					<a href={`/blog/${featuredPost.slug}/`} class="hero-card">
						<div class="hero-img-wrap">
							<img src={featuredPost.data.heroImage || '/poster7.png'} alt={featuredPost.data.title} onerror="this.src='/poster7.png'" />
						</div>
						<div class="hero-info">
							<span class="badge">Featured Review</span>
							<h1 class="hero-title">{featuredPost.data.title}</h1>
							<span class="post-date">{featuredPost.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
						</div>
					</a>
				</div>
			)}

			<div class="spotlight-wrapper">
				<div class="section-header"><h2 class="section-title">Spotlight Series</h2></div>
				<div class="horizontal-scroll-container">
					{spotlightPosters.map((item) => (
						<div class="poster-card-item">
							<img src={item.primary} data-fallback={item.fallback} alt={item.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
						</div>
					))}
				</div>
			</div>

			<div class="section-header"><h2 class="section-title">All Reviews</h2></div>
			<div class="grid-reviews">
				{remainingPosts.map((post, index) => {
					const poster = reviewPosters[index % reviewPosters.length];
					return (
						<a href={`/blog/${post.slug}/`} class="review-item-card">
							<div class="review-img-wrap">
								<img src={post.data.heroImage || poster.primary} data-fallback={poster.fallback} alt={post.data.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
							</div>
							<div class="review-card-info">
								<span class="post-date">{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
								<h3 class="review-card-title">{post.data.title}</h3>
							</div>
						</a>
					);
				})}
			</div>
		</main>

		<footer class="site-footer">
			<div class="footer-socials">
				<a href="https://instagram.com/zoomout_says" target="_blank" rel="noopener noreferrer" class="footer-social-link">Instagram (@zoomout_says)</a>
			</div>
			<p>&copy; {new Date().getFullYear()} Scene & Opinion. All rights reserved.</p>
		</footer>

		<script>
			const toggleBtn = document.getElementById('menuToggle');
			const drawer = document.getElementById('mobileDrawer');
			toggleBtn?.addEventListener('click', () => drawer?.classList.toggle('open'));
		</script>
	</body>
</html>