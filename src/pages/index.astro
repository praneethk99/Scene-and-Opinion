---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Define side posters and video slides with YouTube links
const sidebarImages = [
	'/peddi_discussion.png',
	'/michel_discussion.png',
	'/dacoit.png',
	'/vas.png',
	'/peddi.jpg',

];

// Carousel items with thumbnails and YouTube video URLs
const videoSlides = [
	{
		img: '/peddi_discussion.png',
		videoUrl: 'https://www.youtube.com/watch?v=0xKAzXh6TWo&t=2s'
	},
	{
		img: 'michel_discussion.png',
		videoUrl: 'https://www.youtube.com/watch?v=eNOBxueQOJ4'
	},
	{
		img: '/dacoit.png',
		videoUrl: 'https://www.youtube.com/watch?v=ui4_aX5FVNc'
	},
	{
		img: 'vas.png',
		videoUrl: 'https://www.youtube.com/watch?v=NocBFHwJARQ'
	},
	{
		img: '/peddi.png',
		videoUrl: 'https://www.youtube.com/watch?v=zg5gDJFhcyQ'
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			*, *::before, *::after {
				box-sizing: border-box;
			}

			html, body {
				max-width: 100%;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
				background-color: #0b132b;
				color: #ffffff;
				font-family: system-ui, -apple-system, sans-serif;
			}

			/* 3-Column Page Grid */
			.page-container {
				display: grid;
				grid-template-columns: 240px minmax(0, 1fr) 240px;
				gap: 2rem;
				max-width: 1400px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}

			.main-content {
				width: 100%;
				min-width: 0;
			}

			/* Vertical Sidebars */
			.sidebar {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.sidebar img {
				width: 100%;
				height: 320px;
				aspect-ratio: 3 / 4;
				object-fit: cover;
				border-radius: 12px;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
			}

			/* Content Styling */
			h1 { font-size: 2.2rem; margin-bottom: 1rem; color: #fff; }
			h2 { font-size: 1.5rem; color: #58a6ff; margin-top: 1.5rem; }
			p, li { font-size: 1.05rem; line-height: 1.6; color: #e6edf3; }
			a { color: #58a6ff; }

			/* Widescreen Interactive Video Carousel */
			.carousel-section {
				margin-top: 2rem;
				width: 100%;
			}

			.carousel-wrapper {
				position: relative;
				width: 100%;
				overflow: hidden;
				border-radius: 12px;
			}

			.carousel-track {
				display: flex;
				transition: transform 0.5s ease-in-out;
				width: 100%;
			}

			/* Slide Container & Clickable Anchor */
			.carousel-slide-link {
				min-width: 100%;
				width: 100%;
				position: relative;
				display: block;
				text-decoration: none;
				border-radius: 12px;
				overflow: hidden;
			}

			.carousel-slide-img {
				width: 100%;
				aspect-ratio: 16 / 9;
				height: auto;
				max-height: 420px;
				object-fit: cover;
				display: block;
				transition: transform 0.3s ease;
			}

			/* Play Button Overlay */
			.play-button-overlay {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 68px;
				height: 68px;
				background-color: rgba(0, 0, 0, 0.7);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
				transition: all 0.3s ease;
				backdrop-filter: blur(4px);
			}

			.play-icon {
				width: 0;
				height: 0;
				border-top: 12px solid transparent;
				border-bottom: 12px solid transparent;
				border-left: 20px solid #ffffff;
				margin-left: 4px; /* Center triangular alignment */
			}

			/* Hover Effects */
			.carousel-slide-link:hover .play-button-overlay {
				background-color: #ff0000; /* YouTube Red on Hover */
				transform: translate(-50%, -50%) scale(1.15);
			}

			.carousel-slide-link:hover .carousel-slide-img {
				transform: scale(1.02);
			}

			/* Navigation Dots */
			.carousel-dots {
				display: flex;
				justify-content: center;
				gap: 8px;
				margin-top: 1rem;
			}

			.dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
				background-color: rgba(255, 255, 255, 0.3);
				cursor: pointer;
				transition: all 0.3s ease;
			}

			.dot.active {
				background-color: #58a6ff;
				width: 24px;
				border-radius: 8px;
			}

			/* Responsive Rules */
			@media (max-width: 1024px) {
				.page-container {
					grid-template-columns: 1fr;
				}
				.sidebar {
					display: none;
				}
			}

			@media (max-width: 600px) {
				.play-button-overlay {
					width: 50px;
					height: 50px;
				}
				.play-icon {
					border-top: 9px solid transparent;
					border-bottom: 9px solid transparent;
					border-left: 15px solid #ffffff;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<div class="page-container">
			<!-- Left Sidebar Posters -->
			<aside class="sidebar">
				<img src={sidebarImages[0]} alt="Poster 1" />
				<img src={sidebarImages[1]} alt="Poster 2" />
				<img src={sidebarImages[2]} alt="Poster 3" />
			</aside>

			<!-- Center Main Content -->
			<main class="main-content">
				<h1>Scenes, Hot Takes, and Cinematic Breaks 🎬 🍿</h1>
				<p>
					Welcome to <strong>Scene and Opinion</strong>—your go-to spot for unfiltered movie reviews, 
					sharp film breakdowns, and the freshest updates in cinema.
				</p>

				<h2>What We Do</h2>
				<ul>
					<li>Honest Movie Reviews</li>
					<li>Deep-Dive Film Breakdowns</li>
					<li>Fresh Cinema News & Updates</li>
				</ul>

				<h2>Follow the Channel</h2>
				<p>
					Catch daily takes and quick reviews on our <a href="https://instagram.com/zoomout_says" target="_blank" rel="noopener noreferrer">Instagram</a> 
					and watch full in-depth video analysis on our YouTube channel.
				</p>

				<!-- VIDEO CAROUSEL WITH PLAY BUTTON -->
				<div class="carousel-section">
					<div class="carousel-wrapper">
						<div class="carousel-track" id="carouselTrack">
							{videoSlides.map((slide, index) => (
								<a 
									href={slide.videoUrl} 
									target="_blank" 
									rel="noopener noreferrer" 
									class="carousel-slide-link"
									aria-label={`Watch video ${index + 1} on YouTube`}
								>
									<img src={slide.img} alt={`Video Thumbnail ${index + 1}`} class="carousel-slide-img" />
									<div class="play-button-overlay">
										<div class="play-icon"></div>
									</div>
								</a>
							))}
						</div>
					</div>
					<div class="carousel-dots" id="carouselDots">
						{videoSlides.map((_, index) => (
							<span class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></span>
						))}
					</div>
				</div>
			</main>

			<!-- Right Sidebar Posters -->
			<aside class="sidebar">
				<img src={sidebarImages[3]} alt="Poster 4" />
				<img src={sidebarImages[4]} alt="Poster 5" />
				<img src={sidebarImages[5]} alt="Poster 6" />
			</aside>
		</div>

		<Footer />

		<!-- Client-Side Carousel Script -->
		<script>
			const track = document.getElementById('carouselTrack') as HTMLElement;
			const dots = document.querySelectorAll('.dot');
			const totalSlides = dots.length;
			let currentIndex = 0;

			function updateCarousel(index: number) {
				currentIndex = index;
				track.style.transform = `translateX(-${currentIndex * 100}%)`;

				dots.forEach((dot, i) => {
					dot.classList.toggle('active', i === currentIndex);
				});
			}

			// Auto scroll every 4 seconds
			setInterval(() => {
				const nextIndex = (currentIndex + 1) % totalSlides;
				updateCarousel(nextIndex);
			}, 4000);

			// Click dot to navigate manually
			dots.forEach((dot) => {
				dot.addEventListener('click', (e) => {
					const target = e.target as HTMLElement;
					const index = parseInt(target.getAttribute('data-index') || '0', 10);
					updateCarousel(index);
				});
			});
		</script>
	</body>
</html>