---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const spotlightPosters = [
	{ primary: '/poster12.png', fallback: '/poster12.jpg', title: 'Jana Nayagan' },
	{ primary: '/poster13.png', fallback: '/poster13.jpg', title: 'Lenin' },
	{ primary: '/poster14.png', fallback: '/poster14.jpg', title: 'Evil Dead Burn' },
	{ primary: '/poster15.png', fallback: '/poster15.jpg', title: 'Mukhbir' },
	{ primary: '/poster16.png', fallback: '/poster16.jpg', title: 'Dark Light' }
];

const reviewPosters = [
	{ primary: '/poster1.png', fallback: '/poster1.jpg' },
	{ primary: '/poster2.png', fallback: '/poster2.jpg' },
	{ primary: '/poster3.png', fallback: '/poster3.jpg' },
	{ primary: '/poster4.png', fallback: '/poster4.jpg' },
	{ primary: '/poster5.png', fallback: '/poster5.jpg' },
	{ primary: '/poster6.png', fallback: '/poster6.jpg' }
];

const watchPosters = [
	{ primary: '/poster7.png', fallback: '/poster7.jpg', title: 'Watch Review 1', youtubeUrl: 'https://youtube.com/@zoomout_says' },
	{ primary: '/poster8.png', fallback: '/poster8.jpg', title: 'Watch Review 2', youtubeUrl: 'https://youtube.com/@zoomout_says' },
	{ primary: '/poster9.png', fallback: '/poster9.jpg', title: 'Watch Review 3', youtubeUrl: 'https://youtube.com/@zoomout_says' },
	{ primary: '/poster10.png', fallback: '/poster10.jpg', title: 'Watch Review 4', youtubeUrl: 'https://youtube.com/@zoomout_says' },
	{ primary: '/poster11.png', fallback: '/poster11.jpg', title: 'Watch Review 5', youtubeUrl: 'https://youtube.com/@zoomout_says' },
	{ primary: '/poster12.png', fallback: '/poster12.jpg', title: 'Watch Review 6', youtubeUrl: 'https://youtube.com/@zoomout_says' }
];

const socialLinks = {
	instagram: "https://instagram.com/zoomout_says",
	youtube: "https://youtube.com/@zoomout_says",
	email: "mailto:contact@sceneandopinion.com"
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: #0b132b;
				color: #ffffff;
				font-family: system-ui, -apple-system, sans-serif;
				margin: 0;
			}

			.desktop-view { display: block; }
			.mobile-view { display: none; }

			@media (max-width: 768px) {
				.desktop-view { display: none !important; }
				.mobile-view { display: block !important; }
			}

			/* SHARED INTRO SECTION STYLES */
			.intro-section {
				background: #101a36;
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 12px;
				padding: 2rem;
				margin-bottom: 3.5rem;
			}

			.intro-title {
				font-size: 2rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0 0 0.5rem 0;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.intro-subtitle {
				font-size: 1.1rem;
				color: #c9d1d9;
				margin-bottom: 1.5rem;
				line-height: 1.5;
			}

			.intro-heading {
				font-size: 1.25rem;
				color: #58a6ff;
				margin: 1.5rem 0 0.75rem 0;
				font-weight: 600;
			}

			.intro-list {
				list-style-type: disc;
				padding-left: 1.25rem;
				margin: 0 0 1.5rem 0;
				color: #c9d1d9;
			}

			.intro-list li {
				margin-bottom: 0.4rem;
				font-size: 1rem;
			}

			.intro-footer-text {
				color: #c9d1d9;
				font-size: 1rem;
				line-height: 1.5;
				margin: 0;
			}

			.intro-footer-text a {
				color: #58a6ff;
				text-decoration: underline;
			}

			/* DESKTOP STYLES */
			.read-container {
				max-width: 1300px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}

			.section-title {
				font-size: 1.3rem;
				color: #58a6ff;
				margin-bottom: 1.25rem;
				border-left: 4px solid #58a6ff;
				padding-left: 0.6rem;
			}

			.top-featured-wrapper {
				max-width: 900px;
				margin: 0 auto 3.5rem auto;
			}

			.featured-hero-link {
				display: block;
				text-decoration: none;
				color: inherit;
			}

			.featured-hero {
				display: grid;
				grid-template-columns: 1.2fr 1fr;
				gap: 1.5rem;
				background: #1c2541;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.12);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}

			.featured-hero-link:hover .featured-hero {
				transform: translateY(-4px);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
				border-color: #58a6ff;
			}

			.hero-banner-wrap {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background-color: #101a36;
			}

			.hero-banner-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.featured-content {
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.badge {
				background: #58a6ff;
				color: #0b132b;
				font-weight: bold;
				font-size: 0.75rem;
				padding: 0.25rem 0.6rem;
				border-radius: 4px;
				width: fit-content;
				margin-bottom: 0.75rem;
				text-transform: uppercase;
			}

			.featured-title {
				font-size: 1.75rem;
				margin: 0.25rem 0 0.5rem 0;
				color: #ffffff;
				line-height: 1.3;
			}

			.post-date {
				font-size: 0.85rem;
				color: #8b949e;
				margin-bottom: 0.75rem;
			}

			.featured-snippet {
				font-size: 0.95rem;
				color: #c9d1d9;
				line-height: 1.5;
				margin: 0;
			}

			.carousel-container {
				position: relative;
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 12px;
				padding: 1.25rem 2.5rem;
				background: #101a36;
				margin-bottom: 3.5rem;
			}

			.poster-grid-carousel {
				display: flex;
				gap: 1.25rem;
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				scrollbar-width: none;
				padding-bottom: 0.25rem;
			}

			.spotlight-card {
				flex: 0 0 calc(20% - 1rem);
				scroll-snap-align: start;
				aspect-ratio: 2 / 3;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.1);
				background-color: #1c2541;
				display: block;
			}

			.watch-card {
				flex: 0 0 calc(16.666% - 1rem);
				scroll-snap-align: start;
				aspect-ratio: 2 / 3;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.1);
				background-color: #1c2541;
				display: block;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}

			.watch-card:hover {
				transform: scale(1.03);
				border-color: #58a6ff;
			}

			.spotlight-card img, .watch-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.carousel-nav-btn {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				width: 34px;
				height: 34px;
				background-color: rgba(0, 0, 0, 0.75);
				border: 1px solid rgba(255, 255, 255, 0.3);
				color: #ffffff;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				z-index: 2;
			}

			.carousel-nav-btn.prev { left: 0.6rem; }
			.carousel-nav-btn.next { right: 0.6rem; }

			.grid-5-columns {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1.25rem;
				margin-bottom: 3.5rem;
			}

			.article-poster-card {
				display: flex;
				flex-direction: column;
				background: #1c2541;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.08);
				text-decoration: none;
				color: inherit;
			}

			.poster-img-wrap {
				width: 100%;
				aspect-ratio: 2 / 3;
				overflow: hidden;
				background-color: #101a36;
			}

			.poster-img-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.card-info {
				padding: 0.85rem;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.card-title {
				font-size: 0.95rem;
				font-weight: 600;
				color: #ffffff;
				margin: 0;
				line-height: 1.3;
			}

			/* MOBILE DEDICATED STYLES */
			.mobile-header-bar {
				position: fixed;
				top: 0; left: 0; right: 0;
				background-color: #0d1b2a;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				z-index: 100;
				padding: 0.75rem 1rem;
			}

			.mobile-brand-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.6rem;
			}

			.mobile-brand {
				font-weight: 700;
				font-size: 1.1rem;
				color: #ffffff;
				text-decoration: none;
			}

			.mobile-brand span { color: #58a6ff; }

			.mobile-nav-tabs {
				display: flex;
				gap: 1.25rem;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				padding-top: 0.5rem;
			}

			.mobile-nav-link {
				color: #8b949e;
				text-decoration: none;
				font-size: 0.9rem;
				font-weight: 600;
				padding-bottom: 0.2rem;
			}

			.mobile-nav-link.active {
				color: #58a6ff;
				border-bottom: 2px solid #58a6ff;
			}

			.mobile-main {
				padding: 105px 0.75rem 1.5rem 0.75rem;
			}

			.mobile-intro {
				padding: 1.25rem;
				margin-bottom: 1.75rem;
			}

			.mobile-intro .intro-title {
				font-size: 1.4rem;
			}

			.mobile-featured-card {
				display: block;
				background: #1c2541;
				border-radius: 10px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				margin-bottom: 1.75rem;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}

			.mobile-featured-img {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
			}

			.mobile-featured-body {
				padding: 1rem;
			}

			.mobile-scroll-row {
				display: flex;
				gap: 0.75rem;
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				padding-bottom: 0.5rem;
				margin-bottom: 1.75rem;
				scrollbar-width: none;
			}

			.mobile-scroll-row::-webkit-scrollbar { display: none; }

			.mobile-poster-item {
				flex: 0 0 135px;
				scroll-snap-align: start;
				aspect-ratio: 2 / 3;
				border-radius: 8px;
				overflow: hidden;
				background-color: #1c2541;
				display: block;
			}

			.mobile-poster-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.mobile-grid-2 {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.75rem;
				margin-bottom: 1.75rem;
			}

			.mobile-social-links {
				display: flex;
				justify-content: center;
				gap: 1.25rem;
				margin-bottom: 1rem;
			}

			.mobile-social-links a {
				color: #58a6ff;
				text-decoration: none;
				font-size: 0.85rem;
				font-weight: 500;
			}

			.mobile-footer {
				text-align: center;
				padding: 1.5rem 1rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				font-size: 0.85rem;
				color: #8b949e;
			}
		</style>
	</head>
	<body>

		<!-- DESKTOP VIEW -->
		<div class="desktop-view">
			<Header />

			<div class="read-container">
				<!-- INTRO SECTION -->
				<section class="intro-section">
					<h1 class="intro-title">Scenes, Hot Takes, and Cinematic Breaks 🎬 🍿</h1>
					<p class="intro-subtitle">
						Welcome to <strong>Scene and Opinion</strong>—your go-to spot for unfiltered movie reviews, sharp film breakdowns, and the freshest updates in cinema.
					</p>

					<h2 class="intro-heading">What We Do</h2>
					<ul class="intro-list">
						<li>Honest Movie Reviews</li>
						<li>Deep-Dive Film Breakdowns</li>
						<li>Fresh Cinema News & Updates</li>
					</ul>

					<h2 class="intro-heading">Follow the Channel</h2>
					<p class="intro-footer-text">
						Catch daily takes and quick reviews on our <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> and watch full in-depth video analysis on our <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube channel</a>.
					</p>
				</section>

				{featuredPost && (
					<div class="top-featured-wrapper">
						<a href={`/blog/${featuredPost.slug}/`} class="featured-hero-link">
							<div class="featured-hero">
								<div class="hero-banner-wrap">
									<img src={featuredPost.data.heroImage || '/poster7.png'} alt={featuredPost.data.title} onerror="this.src='/poster7.png'" />
								</div>
								<div class="featured-content">
									<span class="badge">Top Featured</span>
									<h1 class="featured-title">{featuredPost.data.title}</h1>
									<span class="post-date">{featuredPost.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
									<p class="featured-snippet">{featuredPost.data.description || 'Read our full in-depth review...'}</p>
								</div>
							</div>
						</a>
					</div>
				)}

				<h2 class="section-title">Spotlight Series</h2>
				<div class="carousel-container">
					<button class="carousel-nav-btn prev" aria-label="Previous">&#10094;</button>
					<div class="poster-grid-carousel">
						{spotlightPosters.map((item) => (
							<div class="spotlight-card">
								<img src={item.primary} data-fallback={item.fallback} alt={item.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
							</div>
						))}
					</div>
					<button class="carousel-nav-btn next" aria-label="Next">&#10095;</button>
				</div>

				<h2 class="section-title">All Reviews</h2>
				<div class="grid-5-columns">
					{remainingPosts.map((post, index) => {
						const poster = reviewPosters[index % reviewPosters.length];
						return (
							<a href={`/blog/${post.slug}/`} class="article-poster-card">
								<div class="poster-img-wrap">
									<img src={post.data.heroImage || poster.primary} data-fallback={poster.fallback} alt={post.data.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
								</div>
								<div class="card-info">
									<span class="post-date">{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
									<h3 class="card-title">{post.data.title}</h3>
								</div>
							</a>
						);
					})}
				</div>

				<!-- BOTTOM 6-IMAGE CAROUSEL (POSTER 7 to 12) REDIRECTING TO YOUTUBE -->
				<h2 class="section-title">Watch Video Reviews</h2>
				<div class="carousel-container">
					<button class="carousel-nav-btn prev" aria-label="Previous">&#10094;</button>
					<div class="poster-grid-carousel">
						{watchPosters.map((item) => (
							<a href={item.youtubeUrl} target="_blank" rel="noopener noreferrer" class="watch-card">
								<img src={item.primary} data-fallback={item.fallback} alt={item.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
							</a>
						))}
					</div>
					<button class="carousel-nav-btn next" aria-label="Next">&#10095;</button>
				</div>
			</div>

			<Footer />
		</div>

		<!-- MOBILE VIEW -->
		<div class="mobile-view">
			<header class="mobile-header-bar">
				<div class="mobile-brand-row">
					<a href="/" class="mobile-brand">SCENE <span>& OPINION</span></a>
					<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" style="color:#58a6ff; font-weight:600; text-decoration:none; font-size:0.85rem;">@zoomout_says</a>
				</div>
				<nav class="mobile-nav-tabs">
					<a href="/" class="mobile-nav-link active">Home</a>
					<a href="/blog/" class="mobile-nav-link">Read</a>
					<a href="/watch/" class="mobile-nav-link">Watch</a>
				</nav>
			</header>

			<main class="mobile-main">
				<!-- MOBILE INTRO SECTION -->
				<section class="intro-section mobile-intro">
					<h1 class="intro-title">Scenes, Hot Takes, and Cinematic Breaks 🎬 🍿</h1>
					<p class="intro-subtitle">
						Welcome to <strong>Scene and Opinion</strong>—your go-to spot for unfiltered movie reviews, sharp film breakdowns, and the freshest updates in cinema.
					</p>

					<h2 class="intro-heading">What We Do</h2>
					<ul class="intro-list">
						<li>Honest Movie Reviews</li>
						<li>Deep-Dive Film Breakdowns</li>
						<li>Fresh Cinema News & Updates</li>
					</ul>

					<h2 class="intro-heading">Follow the Channel</h2>
					<p class="intro-footer-text">
						Catch daily takes and quick reviews on our <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> and watch full in-depth video analysis on our <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube channel</a>.
					</p>
				</section>

				{featuredPost && (
					<a href={`/blog/${featuredPost.slug}/`} class="mobile-featured-card">
						<img src={featuredPost.data.heroImage || '/poster7.png'} class="mobile-featured-img" alt={featuredPost.data.title} onerror="this.src='/poster7.png'" />
						<div class="mobile-featured-body">
							<span class="badge">Featured</span>
							<h2 style="font-size: 1.2rem; margin: 0.4rem 0;">{featuredPost.data.title}</h2>
							<span class="post-date">{featuredPost.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
						</div>
					</a>
				)}

				<h3 style="color:#58a6ff; font-size: 1.05rem; margin-bottom:0.75rem;">Spotlight Series</h3>
				<div class="mobile-scroll-row">
					{spotlightPosters.map((item) => (
						<div class="mobile-poster-item">
							<img src={item.primary} data-fallback={item.fallback} alt={item.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
						</div>
					))}
				</div>

				<h3 style="color:#58a6ff; font-size: 1.05rem; margin-bottom:0.75rem;">All Reviews</h3>
				<div class="mobile-grid-2">
					{remainingPosts.map((post, index) => {
						const poster = reviewPosters[index % reviewPosters.length];
						return (
							<a href={`/blog/${post.slug}/`} class="article-poster-card">
								<div class="poster-img-wrap">
									<img src={post.data.heroImage || poster.primary} data-fallback={poster.fallback} alt={post.data.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
								</div>
								<div class="card-info">
									<span class="post-date" style="font-size:0.75rem;">{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
									<h4 class="card-title" style="font-size:0.85rem;">{post.data.title}</h4>
								</div>
							</a>
						);
					})}
				</div>

				<!-- MOBILE BOTTOM CAROUSEL FOR YOUTUBE WATCH LINKS -->
				<h3 style="color:#58a6ff; font-size: 1.05rem; margin-bottom:0.75rem;">Watch Video Reviews</h3>
				<div class="mobile-scroll-row">
					{watchPosters.map((item) => (
						<a href={item.youtubeUrl} target="_blank" rel="noopener noreferrer" class="mobile-poster-item">
							<img src={item.primary} data-fallback={item.fallback} alt={item.title} onerror="if(this.getAttribute('data-fallback')){this.src=this.getAttribute('data-fallback');this.removeAttribute('data-fallback');}" />
						</a>
					))}
				</div>
			</main>

			<footer class="mobile-footer">
				<div class="mobile-social-links">
					<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
					<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
					<a href={socialLinks.email}>Email</a>
				</div>
				<p>&copy; {new Date().getFullYear()} Scene & Opinion (@zoomout_says)</p>
			</footer>
