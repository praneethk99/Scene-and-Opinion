---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const socialLinks = {
	youtube: "https://www.youtube.com/@Sceneandopinion",
	instagram: "https://www.instagram.com/sceneandopinion/",
	email: "mailto:sceneandopinion69@gmail.com"
};

// 4 posters on the left
const leftPosters = [
	{ title: 'Varanasi', image: '/poster1.png', fallback: '/poster1.jpg' },
	{ title: 'Kudumbam', image: '/poster2.png', fallback: '/poster2.jpg' },
	{ title: 'Fauzi', image: '/poster3.png', fallback: '/poster3.jpg' },
	{ title: 'Movie 4', image: '/poster4.png', fallback: '/poster4.jpg' }
];

// 4 posters on the right
const rightPosters = [
	{ title: 'Spider-Man', image: '/poster5.png', fallback: '/poster5.jpg' },
	{ title: 'Gladiator', image: '/poster6.png', fallback: '/poster6.jpg' },
	{ title: 'Movie 12', image: '/poster12.png', fallback: '/poster12.jpg' },
	{ title: 'Movie 13', image: '/poster13.png', fallback: '/poster13.jpg' }
];

// 5 Carousel posters placed at the top (Posters 7 to 11) with YouTube links
const carouselPosters = [
	{ title: 'Poster 7', image: '/poster7.png', fallback: '/poster7.jpg', link: socialLinks.youtube },
	{ title: 'Poster 8', image: '/poster8.png', fallback: '/poster8.jpg', link: socialLinks.youtube },
	{ title: 'Poster 9', image: '/poster9.png', fallback: '/poster9.jpg', link: socialLinks.youtube },
	{ title: 'Poster 10', image: '/poster10.png', fallback: '/poster10.jpg', link: socialLinks.youtube },
	{ title: 'Poster 11', image: '/poster11.png', fallback: '/poster11.jpg', link: socialLinks.youtube }
];

// Audience Poll Options
const pollData = {
	question: "Which movie are you most excited to watch this month?",
	options: [
		{ id: "opt1", text: "Peddi", votes: 412 },
		{ id: "opt2", text: "Spider-Man: Beyond the Spider-Verse", votes: 328 },
		{ id: "opt3", text: "Gladiator II", votes: 195 },
		{ id: "opt4", text: "Varanasi Express", votes: 114 }
	]
};

// Box Office & Trending Hub Data
const trendingHub = {
	topMovie: {
		title: "Peddi",
		revenue: "$142M Global Opening",
		verdict: "Blockbuster Hit 🔥"
	},
	fanFavorite: {
		title: "Spider-Man: Beyond the Spider-Verse",
		tag: "Highest Hype Ratio"
	}
};

// Additional Features Data (Quote & Meme of the Week)
const communityFeatures = {
	quoteOfTheDay: {
		text: "“Cinema is a mirror by which we make sense of the magnificent chaos inside us.”",
		source: "— Scene & Opinion Editorial"
	},
	memeOfTheWeek: {
		title: "Meme of the Week 🍿",
		caption: "Waiting for the post-credits scene when you've already finished your popcorn and soda 45 minutes ago."
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- Modern Sans Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">

		<style>
			:root {
				--bg-main: #060e20;
				--bg-nav: #081226;
				--bg-card: #0d1933;
				--accent-blue: #3b82f6;
				--accent-cyan: #06b6d4;
				--accent-purple: #8b5cf6;
				--text-light: #ffffff;
				--text-muted: #94a3b8;
				--border-color: rgba(255, 255, 255, 0.08);
			}

			* {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-main);
				color: var(--text-light);
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
				margin: 0;
				padding: 0;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			/* NAVBAR */
			.navbar {
				background-color: var(--bg-nav);
				border-bottom: 1px solid var(--border-color);
				padding: 0.75rem 2.5rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.brand-container {
				display: flex;
				align-items: center;
				gap: 1rem;
				justify-self: start;
			}

			.brand-logo-img {
				height: 56px;
				width: 56px;
				object-fit: contain;
				background-color: #ffffff;
				border-radius: 8px;
				padding: 4px;
				flex-shrink: 0;
			}

			.brand-text-wrap {
				display: flex;
				flex-direction: column;
			}

			.brand-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: #ffffff;
				line-height: 1.2;
			}

			.brand-caption {
				font-size: 0.8rem;
				color: #a0aec0;
				margin-top: 0.1rem;
			}

			.nav-links {
				display: flex;
				gap: 2rem;
				align-items: center;
				justify-self: center;
			}

			.nav-link {
				font-size: 1rem;
				font-weight: 600;
				color: #cbd5e1;
				transition: color 0.2s;
			}

			.nav-link:hover {
				color: #ffffff;
			}

			.nav-link.active {
				color: #ffffff;
				font-weight: 700;
				border-bottom: 2px solid #ffffff;
				padding-bottom: 0.15rem;
			}

			.header-socials {
				display: flex;
				align-items: center;
				gap: 1rem;
				justify-self: end;
			}

			.social-icon-btn {
				color: #ffffff;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0.9;
				transition: opacity 0.2s, transform 0.2s;
			}

			.social-icon-btn svg {
				width: 24px;
				height: 24px;
			}

			.social-icon-btn:hover {
				opacity: 1;
				transform: scale(1.1);
			}

			/* MAIN GRID */
			.main-layout {
				width: 100%;
				max-width: 100%;
				margin: 1.25rem 0;
				padding: 0 1.5rem;
				display: grid;
				grid-template-columns: 220px 1fr 220px;
				gap: 1.25rem;
				align-items: start;
			}

			/* POSTER COLUMNS */
			.poster-column {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.poster-card {
				width: 100%;
				aspect-ratio: 2 / 3;
				border-radius: 8px;
				overflow: hidden;
				background-color: var(--bg-card);
				border: 1px solid var(--border-color);
			}

			.poster-card img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			/* CENTER CONTENT AREA */
			.center-content {
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				width: 100%;
				max-width: 100%;
			}

			/* CAROUSEL BANNER */
			.featured-video-container {
				width: 100%;
			}

			.video-banner {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid var(--border-color);
				background-color: var(--bg-card);
				display: block;
			}

			.video-banner img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: opacity 0.5s ease-in-out;
			}

			.play-overlay {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 40px;
				height: 40px;
				background-color: rgba(0, 0, 0, 0.7);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: transform 0.2s, background-color 0.2s;
			}

			.play-overlay::after {
				content: '';
				width: 0;
				height: 0;
				border-top: 5px solid transparent;
				border-bottom: 5px solid transparent;
				border-left: 9px solid #ffffff;
				margin-left: 2px;
			}

			.video-banner:hover .play-overlay {
				transform: translate(-50%, -50%) scale(1.1);
				background-color: rgba(0, 0, 0, 0.9);
			}

			.pagination-dots {
				display: flex;
				justify-content: center;
				gap: 0.25rem;
				margin-top: 0.25rem;
			}

			.dot {
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background-color: #334155;
				cursor: pointer;
				transition: background-color 0.2s, width 0.2s;
			}

			.dot.active {
				background-color: var(--accent-blue);
				width: 12px;
				border-radius: 4px;
			}

			/* TEXT CONTENT */
			.text-block {
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
			}

			.main-heading {
				font-size: 1.2rem;
				font-weight: 800;
				margin: 0;
				color: #ffffff;
				line-height: 1.2;
			}

			.welcome-text {
				font-size: 0.78rem;
				line-height: 1.25;
				color: #cbd5e1;
				margin: 0.05rem 0;
			}

			.section-title {
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--accent-blue);
				margin: 0.05rem 0 0 0;
			}

			.feature-list {
				margin: 0 0 0.05rem 1.1rem;
				padding: 0;
				font-size: 0.76rem;
				color: #cbd5e1;
				line-height: 1.2;
			}

			.feature-list li {
				margin-bottom: 0.02rem;
			}

			.channel-info-text {
				font-size: 0.76rem;
				line-height: 1.25;
				color: #cbd5e1;
				margin: 0;
			}

			.text-link {
				color: var(--accent-blue);
				text-decoration: underline;
			}

			/* COMPACT POLL WIDGET */
			.poll-container {
				width: 100%;
				max-width: 100%;
				background: linear-gradient(145deg, #091328, #0e1b38);
				border: 1px solid rgba(59, 130, 246, 0.25);
				border-radius: 8px;
				padding: 0.4rem 0.65rem;
				box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
				box-sizing: border-box;
			}

			.poll-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.15rem;
			}

			.poll-badge {
				background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(139, 92, 246, 0.2));
				border: 1px solid rgba(6, 182, 212, 0.4);
				color: #38bdf8;
				font-size: 0.52rem;
				font-weight: 800;
				padding: 0.08rem 0.35rem;
				border-radius: 10px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.poll-user-status {
				font-size: 0.65rem;
				color: #a7f3d0;
				font-weight: 700;
			}

			.poll-question {
				font-size: 0.8rem;
				font-weight: 800;
				color: #ffffff;
				margin: 0 0 0.25rem 0;
				line-height: 1.2;
			}

			.poll-options {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.poll-option-btn {
				position: relative;
				width: 100%;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 4px;
				padding: 0.22rem 0.5rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				cursor: pointer;
				overflow: hidden;
				transition: border-color 0.2s, transform 0.2s, background-color 0.2s;
			}

			.poll-option-btn:hover {
				border-color: #38bdf8;
				background-color: rgba(56, 189, 248, 0.05);
				transform: translateX(2px);
			}

			.poll-progress-bar {
				position: absolute;
				top: 0;
				left: 0;
				bottom: 0;
				width: 0%;
				background: linear-gradient(90deg, rgba(139, 92, 246, 0.45), rgba(6, 182, 212, 0.45));
				border-right: 2px solid #38bdf8;
				transition: width 0.7s cubic-bezier(0.16, 1, 0.3, 1);
				z-index: 1;
			}

			.poll-left-wrap {
				position: relative;
				z-index: 2;
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}

			.poll-check-pill {
				width: 10px;
				height: 10px;
				border-radius: 50%;
				border: 1.2px solid rgba(255, 255, 255, 0.3);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.4rem;
				color: transparent;
				transition: all 0.2s ease;
				flex-shrink: 0;
			}

			.poll-option-btn.selected-option .poll-check-pill {
				background-color: #38bdf8;
				border-color: #38bdf8;
				color: #060e20;
				box-shadow: 0 0 4px rgba(56, 189, 248, 0.6);
			}

			.poll-option-text {
				font-size: 0.72rem;
				font-weight: 700;
				color: #f1f5f9;
			}

			.poll-option-percent {
				position: relative;
				z-index: 2;
				font-size: 0.72rem;
				font-weight: 800;
				color: #38bdf8;
				display: none;
			}

			.poll-footer {
				margin-top: 0.25rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.62rem;
				color: #94a3b8;
				font-weight: 500;
			}

			/* BOX OFFICE & TRENDING HUB */
			.trending-hub {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.55rem;
				width: 100%;
			}

			.hub-card {
				background: linear-gradient(145deg, #081226, #0d1933);
				border: 1px solid rgba(59, 130, 246, 0.2);
				border-radius: 8px;
				padding: 0.45rem 0.65rem;
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
			}

			.hub-card-label {
				font-size: 0.55rem;
				font-weight: 800;
				color: #38bdf8;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.hub-card-title {
				font-size: 0.78rem;
				font-weight: 800;
				color: #ffffff;
				line-height: 1.2;
			}

			.hub-card-sub {
				font-size: 0.65rem;
				color: #94a3b8;
				font-weight: 600;
			}

			/* COMMUNITY FEATURES (QUOTE & MEME) */
			.community-features {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.55rem;
				width: 100%;
			}

			.community-card {
				background: linear-gradient(145deg, #091328, #0d1933);
				border: 1px solid rgba(139, 92, 246, 0.25);
				border-radius: 8px;
				padding: 0.45rem 0.65rem;
				display: flex;
				flex-direction: column;
				gap: 0.12rem;
			}

			.community-badge {
				font-size: 0.55rem;
				font-weight: 800;
				color: #c084fc;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.community-text {
				font-size: 0.72rem;
				font-style: italic;
				color: #f1f5f9;
				line-height: 1.25;
				margin: 0;
			}

			.community-sub {
				font-size: 0.62rem;
				color: #94a3b8;
				font-weight: 600;
			}

			/* FOOTER */
			.site-footer {
				background-color: var(--bg-nav);
				border-top: 1px solid var(--border-color);
				padding: 1.25rem 2.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
				text-align: center;
				margin-top: 2rem;
			}

			.footer-text {
				font-size: 0.85rem;
				color: #94a3b8;
				margin: 0;
			}

			.footer-contact {
				font-size: 0.85rem;
				color: #cbd5e1;
				margin: 0;
			}

			.footer-contact a {
				color: var(--accent-blue);
				text-decoration: underline;
			}

			/* RESPONSIVE */
			@media (max-width: 900px) {
				.main-layout {
					grid-template-columns: 1fr;
					padding: 0 1rem;
				}
				.poster-column {
					display: grid;
					grid-template-columns: repeat(4, 1fr);
				}
				.navbar {
					display: flex;
					flex-direction: column;
					gap: 1rem;
					padding: 1rem;
					align-items: flex-start;
				}
				.trending-hub, .community-features {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>

		<!-- NAVBAR -->
		<header class="navbar">
			<div class="brand-container">
				<img 
					src="/logo.png" 
					alt="Scene and Opinion Logo" 
					class="brand-logo-img" 
					onerror="if (this.src.endsWith('.png')) { this.src = '/logo.jpg'; }"
				/>
				<div class="brand-text-wrap">
					<a href="/" class="brand-title">Scene and Opinion</a>
					<span class="brand-caption">Fresh reviews before the popcorn cools!</span>
				</div>
			</div>

			<nav class="nav-links">
				<a href="/" class="nav-link active">Home</a>
				<a href="/blog" class="nav-link">Read</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="nav-link">Watch</a>
			</nav>

			<div class="header-socials">
				<a href={socialLinks.email} class="social-icon-btn" aria-label="Email">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
				</a>
				<a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="YouTube">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
				</a>
				<a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
				</a>
			</div>
		</header>

		<!-- MAIN CONTENT LAYOUT -->
		<main class="main-layout">
			
			<!-- LEFT COLUMN POSTERS (4 ITEMS) -->
			<div class="poster-column">
				{leftPosters.map((poster) => (
					<div class="poster-card">
						<img 
							src={poster.image} 
							alt={poster.title} 
							onerror={`if (this.src.endsWith('.png')) { this.src = '${poster.fallback}'; }`} 
						/>
					</div>
				))}
			</div>

			<!-- CENTER CONTENT AREA -->
			<div class="center-content">

				<!-- 1. CAROUSEL BANNER AT TOP -->
				<div class="featured-video-container">
					<a href={carouselPosters[0].link} target="_blank" rel="noopener noreferrer" class="video-banner" id="carousel-link">
						<img 
							id="carousel-img"
							src={carouselPosters[0].image} 
							alt={carouselPosters[0].title} 
							onerror={`if (this.src.endsWith('.png')) { this.src = '${carouselPosters[0].fallback}'; }`} 
						/>
						<div class="play-overlay"></div>
					</a>
					<div class="pagination-dots" id="carousel-dots">
						{carouselPosters.map((_, index) => (
							<span class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></span>
						))}
					</div>
				</div>

				<!-- 2. TEXT CONTENT BELOW THE CAROUSEL -->
				<div class="text-block">
					<h1 class="main-heading">Scenes, Hot Takes, and Cinematic Breaks 🎬 🍿</h1>
					<p class="welcome-text">
						Welcome to <strong>Scene and Opinion</strong>—your go-to spot for unfiltered movie reviews, sharp film breakdowns, and updates.
					</p>

					<h2 class="section-title">What We Do</h2>
					<ul class="feature-list">
						<li>Honest Movie Reviews</li>
						<li>Deep-Dive Film Breakdowns</li>
						<li>Fresh Cinema News & Updates</li>
					</ul>

					<p class="channel-info-text">
						Catch daily takes on <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="text-link">Instagram</a> and video analysis on <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="text-link">YouTube</a>.
					</p>
				</div>

				<!-- 3. POLL SECTION -->
				<div class="poll-container">
					<div class="poll-header">
						<span class="poll-badge">Weekly Audience Poll</span>
						<span class="poll-user-status" id="poll-user-status">Click to vote</span>
					</div>
					<h3 class="poll-question">{pollData.question}</h3>
					
					<div class="poll-options" id="poll-options-container">
						{pollData.options.map((option) => (
							<button class="poll-option-btn" data-id={option.id} data-votes={option.votes}>
								<div class="poll-progress-bar"></div>
								<div class="poll-left-wrap">
									<div class="poll-check-pill">✓</div>
									<span class="poll-option-text">{option.text}</span>
								</div>
								<span class="poll-option-percent">0%</span>
							</button>
						))}
					</div>

					<div class="poll-footer">
						<span id="poll-total-votes">Total Votes: 1,049</span>
						<span>Updated Weekly</span>
					</div>
				</div>

				<!-- 4. BOX OFFICE & TRENDING HUB -->
				<div class="trending-hub">
					<div class="hub-card">
						<span class="hub-card-label">#1 Movie This Week</span>
						<span class="hub-card-title">{trendingHub.topMovie.title}</span>
						<span class="hub-card-sub">{trendingHub.topMovie.revenue} • {trendingHub.topMovie.verdict}</span>
					</div>
					<div class="hub-card">
						<span class="hub-card-label">Fan Favorite Pick</span>
						<span class="hub-card-title">{trendingHub.fanFavorite.title}</span>
						<span class="hub-card-sub">{trendingHub.fanFavorite.tag}</span>
					</div>
				</div>

				<!-- 5. COMMUNITY FEATURES (QUOTE & MEME OF THE WEEK) -->
				<div class="community-features">
					<div class="community-card">
						<span class="community-badge">Cinephile Quote of the Day</span>
						<p class="community-text">{communityFeatures.quoteOfTheDay.text}</p>
						<span class="community-sub">{communityFeatures.quoteOfTheDay.source}</span>
					</div>
					<div class="community-card">
						<span class="community-badge">{communityFeatures.memeOfTheWeek.title}</span>
						<p class="community-text" style="font-style: normal;">{communityFeatures.memeOfTheWeek.caption}</p>
						<span class="community-sub">Community Laughs 🎭</span>
					</div>
				</div>

			</div>

			<!-- RIGHT COLUMN POSTERS (4 ITEMS) -->
			<div class="poster-column">
				{rightPosters.map((poster) => (
					<div class="poster-card">
						<img 
							src={poster.image} 
							alt={poster.title} 
							onerror={`if (this.src.endsWith('.png')) { this.src = '${poster.fallback}'; }`} 
						/>
					</div>
				))}
			</div>

		</main>

		<!-- FOOTER -->
		<footer class="site-footer">
			<p class="footer-text">© All rights reserved, Scene and Opinion</p>
			<p class="footer-contact">
				Contact us: <a href={socialLinks.email}>sceneandopinion69@gmail.com</a>
			</p>
		</footer>

		<!-- CAROUSEL SCRIPT -->
		<script define:vars={{ carouselPosters }}>
			let currentIndex = 0;
			const imgEl = document.getElementById('carousel-img');
			const linkEl = document.getElementById('carousel-link');
			const dots = document.querySelectorAll('#carousel-dots .dot');

			function updateCarousel(index) {
				currentIndex = index;
				const current = carouselPosters[currentIndex];
				
				imgEl.style.opacity = '0.3';
				setTimeout(() => {
					imgEl.src = current.image;
					imgEl.alt = current.title;
					imgEl.onerror = function() {
						if (this.src.endsWith('.png')) {
							this.src = current.fallback;
						}
					};
					linkEl.href = current.link;
					imgEl.style.opacity = '1';
				}, 200);

				dots.forEach((dot, idx) => {
					if (idx === currentIndex) {
						dot.classList.add('active');
					} else {
						dot.classList.remove('active');
					}
				});
			}

			let autoSlideInterval = setInterval(() => {
				const nextIndex = (currentIndex + 1) % carouselPosters.length;
				updateCarousel(nextIndex);
			}, 10000);

			dots.forEach((dot) => {
				dot.addEventListener('click', (e) => {
					const index = parseInt(e.target.getAttribute('data-index'));
					updateCarousel(index);
					clearInterval(autoSlideInterval);
					autoSlideInterval = setInterval(() => {
						const nextIndex = (currentIndex + 1) % carouselPosters.length;
						updateCarousel(nextIndex);
					}, 10000);
				});
			});
		</script>

		<!-- INTERACTIVE POLL SCRIPT -->
		<script>
			const pollContainer = id => document.getElementById(id);
			const optionBtns = document.querySelectorAll('.poll-option-btn');
			const statusText = pollContainer('poll-user-status');
			const totalVotesEl = pollContainer('poll-total-votes');

			let hasVoted = localStorage.getItem('user_voted_option') !== null;
			let userSelection = localStorage.getItem('user_voted_option');

			function renderPollResults() {
				let total = 0;
				optionBtns.forEach(btn => {
					let votes = parseInt(btn.getAttribute('data-votes'));
					if (btn.getAttribute('data-id') === userSelection && !btn.classList.contains('voted')) {
						votes += 1;
						btn.setAttribute('data-votes', votes.toString());
						btn.classList.add('voted');
					}
					total += votes;
				});

				totalVotesEl.textContent = `Total Votes: ${total.toLocaleString()}`;

				optionBtns.forEach(btn => {
					let votes = parseInt(btn.getAttribute('data-votes'));
					let percentage = total > 0 ? Math.round((votes / total) * 100) : 0;
					
					const bar = btn.querySelector('.poll-progress-bar');
					const percentSpan = btn.querySelector('.poll-option-percent');
					
					if (bar) bar.style.width = `${percentage}%`;
					if (percentSpan) {
						percentSpan.textContent = `${percentage}%`;
						percentSpan.style.display = 'inline-block';
					}

					if (hasVoted) {
						btn.style.cursor = 'default';
						if (btn.getAttribute('data-id') === userSelection) {
							btn.classList.add('selected-option');
							btn.style.borderColor = '#38bdf8';
							btn.style.backgroundColor = 'rgba(56, 189, 248, 0.08)';
						}
					}
				});

				if (hasVoted) {
					statusText.textContent = 'Thanks for voting!';
					statusText.style.color = '#38bdf8';
				}
			}

			if (hasVoted) {
				renderPollResults();
			}

			optionBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					if (hasVoted) return;

					const selectedId = btn.getAttribute('data-id');
					localStorage.setItem('user_voted_option', selectedId);
					hasVoted = true;
					userSelection = selectedId;

					renderPollResults();
				});
			});
		</script>

	</body>
</html>