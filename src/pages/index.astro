---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Poster image array for sidebars & carousel
const images = [
	'/poster1.jpg',
	'/poster2.jpg',
	'/poster3.jpg',
	'/poster4.jpg',
	'/poster5.jpg',
	'/poster6.jpg'
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			*, *::before, *::after {
				box-sizing: border-box;
			}

			html, body {
				max-width: 100%;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
				background-color: #0b132b;
				color: #ffffff;
				font-family: system-ui, -apple-system, sans-serif;
			}

			/* 3-Column Page Grid */
			.page-container {
				display: grid;
				grid-template-columns: 240px minmax(0, 1fr) 240px;
				gap: 2rem;
				max-width: 1400px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}

			.main-content {
				width: 100%;
				min-width: 0; /* Prevents CSS Grid overflow bugs */
			}

			/* Vertical Sidebars */
			.sidebar {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.sidebar img {
				width: 100%;
				height: 320px;
				aspect-ratio: 3 / 4;
				object-fit: cover;
				border-radius: 12px;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
			}

			/* Content Styling */
			h1 { font-size: 2.2rem; margin-bottom: 1rem; color: #fff; }
			h2 { font-size: 1.5rem; color: #58a6ff; margin-top: 1.5rem; }
			p, li { font-size: 1.05rem; line-height: 1.6; color: #e6edf3; }
			a { color: #58a6ff; }

			/* Horizontal Image Carousel Component */
			.carousel-section {
				margin-top: 2rem;
				width: 100%;
			}

			.carousel-wrapper {
				position: relative;
				width: 100%;
				overflow: hidden;
				border-radius: 12px;
			}

			.carousel-track {
				display: flex;
				transition: transform 0.5s ease-in-out;
				gap: 12px;
			}

			.carousel-slide {
				min-width: calc(33.333% - 8px); /* Displays 3 posters at a time */
				height: 260px;
				border-radius: 10px;
				object-fit: cover;
			}

			/* Navigation Dots */
			.carousel-dots {
				display: flex;
				justify-content: center;
				gap: 8px;
				margin-top: 1rem;
			}

			.dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
				background-color: rgba(255, 255, 255, 0.3);
				cursor: pointer;
				transition: background-color 0.3s;
			}

			.dot.active {
				background-color: #58a6ff;
				width: 24px;
				border-radius: 8px;
			}

			/* Responsive Rules */
			@media (max-width: 1024px) {
				.page-container {
					grid-template-columns: 1fr;
				}
				.sidebar {
					display: none;
				}
				.carousel-slide {
					min-width: calc(50% - 6px); /* 2 posters visible on mobile */
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<div class="page-container">
			<!-- Left Sidebar Posters -->
			<aside class="sidebar">
				<img src={images[0]} alt="Poster 1" />
				<img src={images[1]} alt="Poster 2" />
				<img src={images[2]} alt="Poster 3" />
			</aside>

			<!-- Center Main Content -->
			<main class="main-content">
				<h1>Scenes, Hot Takes, and Cinematic Breaks 🎬 🍿</h1>
				<p>
					Welcome to <strong>Scene and Opinion</strong>—your go-to spot for unfiltered movie reviews, 
					sharp film breakdowns, and the freshest updates in cinema.
				</p>

				<h2>What We Do</h2>
				<ul>
					<li>Honest Movie Reviews</li>
					<li>Deep-Dive Film Breakdowns</li>
					<li>Fresh Cinema News & Updates</li>
				</ul>

				<h2>Follow the Channel</h2>
				<p>
					Catch daily takes and quick reviews on our <a href="https://instagram.com/zoomout_says" target="_blank" rel="noopener noreferrer">Instagram</a> 
					and watch full in-depth video analysis on our YouTube channel.
				</p>

				<!-- MOVING IMAGE CAROUSEL AREA -->
				<div class="carousel-section">
					<div class="carousel-wrapper">
						<div class="carousel-track" id="carouselTrack">
							{images.map((src, index) => (
								<img src={src} alt={`Movie Slide ${index + 1}`} class="carousel-slide" />
							))}
						</div>
					</div>
					<div class="carousel-dots" id="carouselDots">
						{images.map((_, index) => (
							<span class={`dot ${index === 0 ? 'active' : ''}`} data-index={index}></span>
						))}
					</div>
				</div>
			</main>

			<!-- Right Sidebar Posters -->
			<aside class="sidebar">
				<img src={images[3]} alt="Poster 4" />
				<img src={images[4]} alt="Poster 5" />
				<img src={images[5]} alt="Poster 6" />
			</aside>
		</div>

		<Footer />

		<!-- Client-Side Script to Drive Auto-Slider Animation -->
		<script>
			const track = document.getElementById('carouselTrack') as HTMLElement;
			const dots = document.querySelectorAll('.dot');
			const totalSlides = dots.length;
			let currentIndex = 0;

			function updateCarousel(index: number) {
				currentIndex = index;
				// Calculates width percentage shift per slide
				const slideWidth = (track.children[0] as HTMLElement).getBoundingClientRect().width + 12;
				track.style.transform = `translateX(-${currentIndex * slideWidth}px)`;

				dots.forEach((dot, i) => {
					dot.classList.toggle('active', i === currentIndex);
				});
			}

			// Auto scroll every 3 seconds
			setInterval(() => {
				const nextIndex = (currentIndex + 1) % (totalSlides - 2); // Loop back when reaching end
				updateCarousel(nextIndex);
			}, 3000);

			// Click dot to navigate manually
			dots.forEach((dot) => {
				dot.addEventListener('click', (e) => {
					const target = e.target as HTMLElement;
					const index = parseInt(target.getAttribute('data-index') || '0', 10);
					updateCarousel(index);
				});
			});
		</script>
	</body>
</html>