				</div>

			</div>

		</div>

		<footer class="site-footer">
			<p class="footer-copyright">© All rights reserved.</p>
			<p class="footer-brand">SCENE AND OPINION</p>
			<a href="mailto:sceneandopinion69@gmail.com" class="footer-email">
				<svg viewBox="0 0 24 24" fill="currentColor" class="footer-mail-icon"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
				sceneandopinion69@gmail.com
			</a>
		</footer>

		<script define:vars={{ carouselPosters }}>
			let currentIndex = 0;
			const imgEl = document.getElementById('carousel-img');
			const linkEl = document.getElementById('carousel-link');
			const dots = document.querySelectorAll('#carousel-dots .dot');

			function updateCarousel(index) {
				currentIndex = index;
				const current = carouselPosters[currentIndex];
				
				imgEl.style.opacity = '0.3';
				setTimeout(() => {
					imgEl.setAttribute('data-base', current.base);
					imgEl.setAttribute('data-formats', JSON.stringify(current.formats));
					imgEl.setAttribute('data-index', '0');
					imgEl.src = current.base + current.formats[0];
					imgEl.alt = '';
					
					imgEl.onerror = function() {
						let formats = JSON.parse(this.getAttribute('data-formats'));
						let currentIndex = parseInt(this.getAttribute('data-index'));
						currentIndex++;
						if (currentIndex < formats.length) {
							this.setAttribute('data-index', currentIndex);
							this.src = this.getAttribute('data-base') + formats[currentIndex];
						}
					};
					
					linkEl.href = current.link;
					imgEl.style.opacity = '1';
				}, 200);

				dots.forEach((dot, idx) => {
					if (idx === currentIndex) {
						dot.classList.add('active');
					} else {
						dot.classList.remove('active');
					}
				});
			}

			let autoSlideInterval = setInterval(() => {
				const nextIndex = (currentIndex + 1) % carouselPosters.length;
				updateCarousel(nextIndex);
			}, 10000);

			dots.forEach((dot) => {
				dot.addEventListener('click', (e) => {
					const index = parseInt(e.target.getAttribute('data-index'));
					updateCarousel(index);
					clearInterval(autoSlideInterval);
					autoSlideInterval = setInterval(() => {
						const nextIndex = (currentIndex + 1) % carouselPosters.length;
						updateCarousel(nextIndex);
					}, 10000);
				});
			});
		</script>

		<!-- DYNAMIC AUDIENCE POLL BACKEND SCRIPT -->
		<script>
			const optionBtns = document.querySelectorAll('.poll-option-btn');
			const statusText = document.getElementById('poll-user-status');
			const totalVotesEl = document.getElementById('poll-total-votes');

			const STORAGE_KEY = 'scene_opinion_live_poll_votes_v3';
			const USER_VOTE_KEY = 'scene_opinion_user_voted_option_v3';

			// Baseline starts completely at zero for all options
			const initialPollState = {
				'opt1': 0,
				'opt2': 0,
				'opt3': 0,
				'opt4': 0,
				'opt5': 0
			};

			// Load saved votes from localStorage or start at zero
			let pollState = JSON.parse(localStorage.getItem(STORAGE_KEY)) || initialPollState;
			let userVotedOption = localStorage.getItem(USER_VOTE_KEY);

			function updateUI() {
				// Calculate total votes dynamically based on current counts
				let total = Object.values(pollState).reduce((a, b) => a + b, 0);
				totalVotesEl.textContent = `Total Votes: ${total.toLocaleString()}`;

				optionBtns.forEach(btn => {
					const id = btn.getAttribute('data-id');
					const votes = pollState[id] || 0;
					const percentage = total > 0 ? Math.round((votes / total) * 100) : 0;

					const bar = document.getElementById(`bar-${id}`);
					const pct = document.getElementById(`pct-${id}`);

					if (bar) bar.style.width = `${percentage}%`;
					if (pct) pct.textContent = `${percentage}%`;

					if (userVotedOption) {
						btn.style.cursor = 'default';
						if (id === userVotedOption) {
							btn.classList.add('selected-option');
						}
					}
				});

				if (userVotedOption) {
					statusText.textContent = 'Thanks for voting!';
					statusText.style.color = '#38bdf8';
				} else {
					statusText.textContent = 'Click an option to vote';
				}
			}

			// Initial render
			updateUI();

			// Handle voting action
			optionBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					if (userVotedOption) return; // Prevent multiple votes per user session

					const selectedId = btn.getAttribute('data-id');
					
					// Increment the chosen option's vote count from zero
					if (pollState[selectedId] !== undefined) {
						pollState[selectedId] += 1;
					} else {
						pollState[selectedId] = 1;
					}

					// Save updated state and user choice
					localStorage.setItem(STORAGE_KEY, JSON.stringify(pollState));
					localStorage.setItem(USER_VOTE_KEY, selectedId);
					userVotedOption = selectedId;

					updateUI();
				});
			});
		</script>
	</body>
</html>