---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Modern Reset & Base Styles */
			*, *::before, *::after {
				box-sizing: border-box;
			}

			html, body {
				max-width: 100%;
				overflow-x: hidden;
				margin: 0;
				padding: 0;
				background-color: #0b132b;
				color: #ffffff;
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
			}

			img, video, iframe, picture, svg {
				max-width: 100%;
				height: auto;
				display: block;
			}

			/* 3-Column Layout Container */
			.page-container {
				display: grid;
				grid-template-columns: 180px minmax(0, 800px) 180px;
				justify-content: center;
				gap: 2rem;
				max-width: 1300px;
				margin: 0 auto;
				padding: clamp(1rem, 3vw, 2.5rem);
			}

			/* Main Content Sizing & Fluid Typography */
			.main-content {
				width: 100%;
			}

			h1 {
				font-size: clamp(1.75rem, 5vw, 2.5rem);
				line-height: 1.2;
				margin-bottom: 1rem;
				color: #ffffff;
			}

			h2 {
				font-size: clamp(1.3rem, 4vw, 1.8rem);
				line-height: 1.3;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				color: #58a6ff;
			}

			p, li {
				font-size: 1.05rem;
				line-height: 1.6;
				color: #e6edf3;
			}

			ul {
				padding-left: 1.2rem;
			}

			a {
				color: #58a6ff;
				text-decoration: none;
			}

			a:hover {
				text-decoration: underline;
			}

			/* Vertical Sidebars */
			.sidebar {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				align-items: center;
			}

			.sidebar img {
				width: 100%;
				border-radius: 12px;
				object-fit: cover;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
				transition: transform 0.2s ease-in-out;
			}

			.sidebar img:hover {
				transform: scale(1.04);
			}

			/* Responsive Breakpoints: Hide sidebars on smaller screens */
			@media (max-width: 1024px) {
				.page-container {
					grid-template-columns: 1fr;
				}

				.sidebar {
					display: none;
				}
			}

			@media (max-width: 600px) {
				button, a {
					min-height: 44px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<div class="page-container">
			<!-- Left Vertical Sidebar -->
			<aside class="sidebar left-sidebar">
				<img src="/poster1.jpg" alt="Featured Poster 1" />
				<img src="/poster2.jpg" alt="Featured Poster 2" />
				<img src="/poster3.jpg" alt="Featured Poster 3" />
			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<h1>Scenes, Hot Takes, and Cinematic Breaks 🎬 🍿</h1>
				<p>
					Welcome to <strong>Scene and Opinion</strong>—your go-to spot for unfiltered movie reviews, 
					sharp film breakdowns, and the freshest updates in cinema. Whether we're dissecting a masterpiece 
					or roasting a flop, we bring the story behind the screen straight to your feed.
				</p>

				<h2>What We Do</h2>
				<ul>
					<li>Honest Movie Reviews</li>
					<li>Deep-Dive Film Breakdowns</li>
					<li>Fresh Cinema News & Updates</li>
				</ul>

				<h2>Follow the Channel</h2>
				<p>
					Catch daily takes and quick reviews on our <a href="https://instagram.com/zoomout_says" target="_blank" rel="noopener noreferrer">Instagram</a> 
					and watch full in-depth video analysis on our YouTube channel.
				</p>
			</main>

			<!-- Right Vertical Sidebar -->
			<aside class="sidebar right-sidebar">
				<img src="/poster4.jpg" alt="Featured Poster 4" />
				<img src="/poster5.jpg" alt="Featured Poster 5" />
				<img src="/poster6.jpg" alt="Featured Poster 6" />
			</aside>
		</div>

		<Footer />
	</body>
</html>