                <script define:vars={{ carouselPosters }}>
                        const fallbackCarousel = Array.isArray(carouselPosters) ? carouselPosters : [];
                        let slides = fallbackCarousel;
                        let currentIndex = 0;
                        let autoSlideInterval = null;
                        let touchStartX = 0;
                        let touchStartY = 0;

                        const imgEl = document.getElementById('carousel-img');
                        const playBtn = document.getElementById('carousel-play');
                        const bannerEl = document.getElementById('carousel-banner');
                        const dotsEl = document.getElementById('carousel-dots');

                        function normalizeSlide(item, index) {
                                return {
                                        base: item?.base || item?.posterBase || `/public_carouselPosters/poster${index + 1}`,
                                        link: item?.link || item?.youtubeLink || 'https://www.youtube.com/@Sceneandopinion',
                                        formats: Array.isArray(item?.formats) && item.formats.length ? item.formats : ['.webp', '.png', '.jpg', '.jpeg'],
                                        title: item?.title || `Featured Scene and Opinion video ${index + 1}`
                                };
                        }

                        function renderDots() {
                                if (!dotsEl) return;
                                dotsEl.innerHTML = '';
                                slides.forEach((_, index) => {
                                        const dot = document.createElement('button');
                                        dot.type = 'button';
                                        dot.className = `carousel-dot ${index === currentIndex ? 'active' : ''}`;
                                        dot.dataset.index = String(index);
                                        dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
                                        if (index === currentIndex) dot.setAttribute('aria-current', 'true');
                                        dot.addEventListener('click', () => {
                                                updateCarousel(index);
                                                restartAutoSlide();
                                        });
                                        dotsEl.appendChild(dot);
                                });
                        }

                        function updatePlayLink(current) {
                                if (!playBtn || !current) return;
                                playBtn.href = current.link;
                                playBtn.setAttribute('aria-label', `Watch ${current.title} on YouTube`);
                                playBtn.title = 'Watch on YouTube';
                        }

                        function updateCarousel(index) {
                                if (!slides.length || !imgEl) return;

                                currentIndex = (index + slides.length) % slides.length;
                                const current = slides[currentIndex];
                                updatePlayLink(current);

                                imgEl.style.opacity = '0.25';
                                const formats = current.formats;
                                let imageIndex = 0;

                                const loadImage = () => {
                                        if (imageIndex >= formats.length) {
                                                imgEl.style.opacity = '1';
                                                return;
                                        }
                                        imgEl.src = current.base + formats[imageIndex];
                                };

                                imgEl.onload = () => { imgEl.style.opacity = '1'; };
                                imgEl.onerror = () => { imageIndex++; loadImage(); };
                                imgEl.alt = current.title;
                                imgEl.setAttribute('data-base', current.base);
                                imgEl.setAttribute('data-formats', JSON.stringify(formats));
                                imgEl.setAttribute('data-index', '0');
                                loadImage();

                                renderDots();
                        }

                        function restartAutoSlide() {
                                if (autoSlideInterval) clearInterval(autoSlideInterval);
                                if (slides.length > 1) {
                                        autoSlideInterval = setInterval(() => updateCarousel(currentIndex + 1), 5000);
                                }
                        }

                        async function loadCarouselLinks() {
                                try {
                                        const response = await fetch('/public_carouselPosters/carousel-links.json', { cache: 'no-store' });
                                        if (!response.ok) throw new Error(`carousel-links.json returned ${response.status}`);
                                        const data = await response.json();
                                        if (!Array.isArray(data) || data.length === 0) throw new Error('carousel-links.json is empty or invalid');
                                        slides = data.map(normalizeSlide);
                                        currentIndex = 0;
                                        updateCarousel(0);
                                        restartAutoSlide();
                                } catch (error) {
                                        console.error('Unable to load carousel-links.json:', error);
                                        slides = fallbackCarousel.map(normalizeSlide);
                                        updateCarousel(0);
                                        restartAutoSlide();
                                }
                        }

                        if (bannerEl) {
                                bannerEl.addEventListener('touchstart', (event) => {
                                        touchStartX = event.changedTouches[0].screenX;
                                        touchStartY = event.changedTouches[0].screenY;
                                }, { passive: true });

                                bannerEl.addEventListener('touchend', (event) => {
                                        const deltaX = event.changedTouches[0].screenX - touchStartX;
                                        const deltaY = event.changedTouches[0].screenY - touchStartY;
                                        if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY) && slides.length > 1) {
                                                updateCarousel(currentIndex + (deltaX < 0 ? 1 : -1));
                                                restartAutoSlide();
                                        }
                                }, { passive: true });
                        }

                        document.addEventListener('visibilitychange', () => {
                                if (document.hidden) {
                                        if (autoSlideInterval) clearInterval(autoSlideInterval);
                                } else {
                                        restartAutoSlide();
                                }
                        });

                        // Start immediately with SSR data, then replace it with carousel-links.json.
                        slides = fallbackCarousel.map(normalizeSlide);
                        updateCarousel(0);
                        restartAutoSlide();
                        loadCarouselLinks();
                </script>

                <!-- SUPABASE AUDIENCE POLL -->
                <script>
                        const optionBtns = document.querySelectorAll('.poll-option-btn');
                        const statusText = document.getElementById('poll-user-status');
                        const totalVotesEl = document.getElementById('poll-total-votes');

                        const POLL_ID = 'weekly-audience-poll';
                        const VOTER_STORAGE_KEY = 'scene_opinion_voter_id_v1';
                        const VOTE_STORAGE_KEY = 'scene_opinion_user_voted_v1';

                        function getVoterId() {
                                let id = localStorage.getItem(VOTER_STORAGE_KEY);

                                if (!id) {
                                        id = 'voter_' + crypto.randomUUID();
                                        localStorage.setItem(VOTER_STORAGE_KEY, id);
                                }

                                return id;
                        }

                        const voterId = getVoterId();
                        let userVotedOption = localStorage.getItem(VOTE_STORAGE_KEY);

                        function updateUI(votes, total) {
                                totalVotesEl.textContent =
                                        `Total Votes: ${Number(total || 0).toLocaleString()}`;

                                optionBtns.forEach((btn) => {
                                        const id = btn.getAttribute('data-id');
                                        if (!id) return;

                                        const count = Number(votes?.[id] || 0);
                                        const percentage =
                                                total > 0 ? Math.round((count / total) * 100) : 0;

                                        const bar = document.getElementById(`bar-${id}`);
                                        const pct = document.getElementById(`pct-${id}`);

                                        if (bar) bar.style.width = `${percentage}%`;
                                        if (pct) pct.textContent = `${percentage}%`;

                                        btn.classList.toggle('selected-option', id === userVotedOption);
                                        btn.disabled = Boolean(userVotedOption);
                                });
                        }

                        async function loadPollResults() {
                                try {
                                        const response = await fetch('/api/poll', {
                                                method: 'GET',
                                                cache: 'no-store',
                                                headers: {
                                                        'Accept': 'application/json'
                                                }
                                        });

                                        const result = await response.json();

                                        if (!response.ok || !result.success) {
                                                throw new Error(
                                                        result.error || 'Unable to load poll results.'
                                                );
                                        }

                                        updateUI(result.votes || {}, Number(result.total || 0));

                                        if (userVotedOption) {
                                                statusText.textContent = 'Thanks for voting!';
                                                statusText.style.color = '#38bdf8';
                                        } else {
                                                statusText.textContent = 'Click an option to vote';
                                                statusText.style.color = '#a7f3d0';
                                        }
                                } catch (error) {
                                        console.error('Poll results error:', error);
                                        statusText.textContent = 'Unable to load live results.';
                                }
                        }

                        async function submitVote(selectedId) {
                                if (userVotedOption) return;

                                if (!selectedId) {
                                        statusText.textContent = 'Please select an option.';
                                        return;
                                }

                                statusText.textContent = 'Submitting vote...';
                                optionBtns.forEach((btn) => {
                                        btn.disabled = true;
                                });

                                const votePayload = {
                                        pollId: POLL_ID,
                                        optionId: String(selectedId),
                                        voterId: String(voterId)
                                };

                                console.log('Sending poll vote:', votePayload);

                                try {
                                        const response = await fetch('/api/poll', {
                                                method: 'POST',
                                                headers: {
                                                        'Content-Type': 'application/json',
                                                        'Accept': 'application/json'
                                                },
                                                body: JSON.stringify(votePayload)
                                        });

                                        const responseText = await response.text();

                                        console.log(
                                                'Poll API response:',
                                                response.status,
                                                responseText
                                        );

                                        let result;

                                        try {
                                                result = JSON.parse(responseText);
                                        } catch {
                                                throw new Error(
                                                        `Invalid server response: ${responseText}`
                                                );
                                        }

                                        if (response.status === 409) {
                                                userVotedOption = selectedId;
                                                localStorage.setItem(VOTE_STORAGE_KEY, selectedId);
                                                statusText.textContent = 'You have already voted.';
                                                await loadPollResults();
                                                return;
                                        }

                                        if (!response.ok || !result.success) {
                                                throw new Error(
                                                        result.error || 'Unable to save your vote.'
                                                );
                                        }

                                        userVotedOption = selectedId;
                                        localStorage.setItem(VOTE_STORAGE_KEY, selectedId);
                                        statusText.textContent = 'Thanks for voting!';
                                        statusText.style.color = '#38bdf8';
                                        await loadPollResults();
                                } catch (error) {
                                        console.error('Vote submission error:', error);
                                        statusText.textContent =
                                                error instanceof Error
                                                        ? error.message
                                                        : 'Could not save your vote. Please try again.';

                                        optionBtns.forEach((btn) => {
                                                btn.disabled = false;
                                        });
                                }
                        }

                        optionBtns.forEach((btn) => {
                                btn.addEventListener('click', (event) => {
                                        event.preventDefault();
                                        const selectedId = btn.getAttribute('data-id');
                                        if (!selectedId) return;
                                        submitVote(selectedId);
                                });
                        });

                        loadPollResults();
                </script>


        </body>
</html>
